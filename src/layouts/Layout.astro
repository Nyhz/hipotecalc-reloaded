---
import { ClientRouter } from "astro:transitions";
import Navbar from '../components/Navbar.tsx';
import Footer from '../components/Footer.astro';
import '../style/globals.css';
// Fuentes autohospedadas (antes Google Fonts): sin conexiones a terceros,
// sin CSS bloqueante y con los pesos que realmente usa la web
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-mono/700.css';
import { getCurrentLang, getAlternatePath, normalizePath } from '../utils/i18n';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonicalURL?: string;
  /** 'legal' emite schema WebPage en lugar de WebApplication */
  pageType?: 'calculator' | 'legal';
}

const SITE_BASE = 'https://www.hipotecalc.com';

// Forma canónica: www y sin barra final (salvo la raíz), igual que sirve
// Vercel en producción. Canonical, og:url y hreflang deben usarla siempre.
const normalizedPath = normalizePath(Astro.url.pathname);

const {
  title = "Calculadora Hipotecaria - España | Herramientas Financieras",
  description = "Calculadora hipotecaria, de alquiler e ITP para España. Herramientas financieras precisas y profesionales para calcular tu hipoteca, impuestos y más.",
  keywords = "calculadora hipoteca, calculadora alquiler, calculadora ITP, finanzas, España, euribor, impuestos, vivienda",
  ogImage,
  canonicalURL = `${SITE_BASE}${normalizedPath}`,
  pageType = 'calculator'
} = Astro.props;

const currentLang = getCurrentLang(normalizedPath);
const langAttribute = currentLang === 'en' ? 'en' : 'es';
const ogLocale = currentLang === 'en' ? 'en_US' : 'es_ES';
const ogImageURL = ogImage ?? `${SITE_BASE}/${currentLang === 'en' ? 'hipotecalc-og-en.jpg' : 'hipotecalc-og.jpg'}`;
const ogImageAlt = currentLang === 'en'
  ? 'Hipotecalc — free mortgage and rental calculators for Spain'
  : 'Hipotecalc — calculadoras gratuitas de hipoteca y alquiler para España';
const isLocalEnv =
  Astro.url.hostname === "localhost" || Astro.url.hostname === "127.0.0.1";

const alternatePath = getAlternatePath(normalizedPath);
// Páginas sin versión en el otro idioma (blog, comparativa): getAlternatePath
// devuelve la misma ruta y no debe emitirse un hreflang alterno falso
const hasAlternate = alternatePath !== normalizedPath;
const esPath = currentLang === 'es' ? normalizedPath : alternatePath;
const enPath = currentLang === 'en' ? normalizedPath : alternatePath;
const hrefLangEs = currentLang === 'es' || hasAlternate ? `${SITE_BASE}${esPath}` : null;
const hrefLangEn = currentLang === 'en' || hasAlternate ? `${SITE_BASE}${enPath}` : null;
const hrefLangDefault = hrefLangEs ?? `${SITE_BASE}${normalizedPath}`;

// Datos estructurados: Organization en todas las páginas; WebSite solo en
// las portadas; WebApplication solo en las calculadoras (no en la home).
const isHome = normalizedPath === '/' || normalizedPath === '/en';

const organizationSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE_BASE}/#organization`,
  "name": "Hipotecalc",
  "url": `${SITE_BASE}/`,
  "logo": `${SITE_BASE}/hipotecalc-og.jpg`
});

const webSiteSchema = isHome ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_BASE}/#website`,
  "name": "Hipotecalc",
  "url": `${SITE_BASE}/`,
  "description": description,
  "inLanguage": langAttribute,
  "publisher": { "@id": `${SITE_BASE}/#organization` }
}) : null;

const webAppSchema = !isHome && pageType === 'calculator' ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title,
  "description": description,
  "url": canonicalURL,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web Browser",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR"
  },
  "creator": { "@id": `${SITE_BASE}/#organization` },
  "inLanguage": langAttribute,
  "keywords": keywords
}) : null;

const webPageSchema = pageType === 'legal' ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": canonicalURL,
  "inLanguage": langAttribute,
  "publisher": { "@id": `${SITE_BASE}/#organization` }
}) : null;
---
<html lang={langAttribute}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    
    <!-- Basic SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Hipotecalc" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Hreflang tags for language alternates -->
    {hrefLangEs && <link rel="alternate" hreflang="es" href={hrefLangEs} />}
    {hrefLangEn && <link rel="alternate" hreflang="en" href={hrefLangEn} />}
    <link rel="alternate" hreflang="x-default" href={hrefLangDefault} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Hipotecalc" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    
    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="theme-color" content="#FAF9F4" />
    
    <!-- Banner de consentimiento (CookieYes): defer para no bloquear el
         render. Los defaults de Consent Mode se fijan en el script inline de
         más abajo, que al ser inline se ejecuta siempre antes que un defer. -->
    {!isLocalEnv && (
      <script defer id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/9f0e347f752a5c179f39585d/script.js" onerror="window.cookieYesBlocked = true;"></script>
    )}

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={organizationSchema} />
    {webSiteSchema && <script type="application/ld+json" set:html={webSiteSchema} />}
    {webAppSchema && <script type="application/ld+json" set:html={webAppSchema} />}
    {webPageSchema && <script type="application/ld+json" set:html={webPageSchema} />}

    <!-- Google Analytics - Managed by CookieYes -->
    <script is:inline>
      // Initialize dataLayer and gtag function immediately
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      
      // Set default consent to denied
      gtag('consent', 'default', {
        'analytics_storage': 'denied'
      });
      
      // Flag to track if GA script is loaded
      window.gaScriptLoaded = false;
      window.lastAnalyticsState = null;
      
      // Function to parse CookieYes consent cookie
      function parseCookieYesConsent() {
        var cookies = document.cookie.split(';');
        var consentCookie = null;
        
        for (var i = 0; i < cookies.length; i++) {
          var cookie = cookies[i].trim();
          if (cookie.startsWith('cookieyes-consent=')) {
            consentCookie = cookie.substring('cookieyes-consent='.length);
            break;
          }
        }
        
        if (!consentCookie) {
          return null;
        }
        
        var consentData = {};
        var parts = consentCookie.split(',');
        
        for (var j = 0; j < parts.length; j++) {
          var keyValue = parts[j].split(':');
          if (keyValue.length === 2) {
            consentData[keyValue[0]] = keyValue[1];
          }
        }
        
        return consentData;
      }
      
      // Function to delete GA cookies
      function deleteGACookies() {
        var domain = window.location.hostname;
        var cookiesToDelete = ['_ga', '_ga_G-RCYZ4N1WPT', '_gid', '_gat_gtag_G_RCYZ4N1WPT'];
        
        cookiesToDelete.forEach(function(cookieName) {
          // Delete for current domain
          document.cookie = cookieName + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=' + domain + ';';
          // Delete for parent domain (if subdomain)
          document.cookie = cookieName + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=.' + domain + ';';
          // Delete without domain
          document.cookie = cookieName + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        });
      }
      
      // Function to load Google Analytics script
      function loadGoogleAnalytics() {
        if (!window.gaScriptLoaded && !document.querySelector('script[src*="googletagmanager.com/gtag/js"]')) {
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=G-RCYZ4N1WPT';
          script.onload = function() {
            window.gaScriptLoaded = true;
            initializeGA();
          };
          document.head.appendChild(script);
        } else if (window.gaScriptLoaded) {
          initializeGA();
        }
      }
      
      // Function to initialize GA with consent
      function initializeGA() {
        gtag('js', new Date());
        gtag('config', 'G-RCYZ4N1WPT', {
          'analytics_storage': 'granted',
          'anonymize_ip': true,
          'send_page_view': true
        });
      }
      
      // Function to enable analytics
      function enableAnalytics() {
        gtag('consent', 'update', {
          'analytics_storage': 'granted'
        });
        loadGoogleAnalytics();
      }
      
      // Function to disable analytics
      function disableAnalytics() {
        gtag('consent', 'update', {
          'analytics_storage': 'denied'
        });
        // Delete existing GA cookies
        deleteGACookies();
      }
      
      // Function to check and handle consent changes
      function handleConsentChange() {
        var consent = parseCookieYesConsent();
        
        if (!consent) {
          return;
        }
        
        var analyticsConsent = consent.analytics;
        
        // Only act if consent state has changed
        if (window.lastAnalyticsState !== analyticsConsent) {
          window.lastAnalyticsState = analyticsConsent;
          
          if (analyticsConsent === 'yes') {
            enableAnalytics();
          } else if (analyticsConsent === 'no') {
            disableAnalytics();
          }
        }
      }
      
      // Make function globally accessible for debugging
      window.handleConsentChange = handleConsentChange;
      window.parseCookieYesConsent = parseCookieYesConsent;
      
      // Monitor cookie changes using polling (since cookie change events don't exist)
      function startCookieMonitoring() {
        // If CookieYes is blocked, don't start monitoring
        if (window.cookieYesBlocked) {
          return;
        }
        
        // Check immediately
        handleConsentChange();
        
        // Then poll every 2000ms for changes
        setInterval(handleConsentChange, 2000);
      }
      
      // Start monitoring when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startCookieMonitoring);
      } else {
        startCookieMonitoring();
      }
    </script>
    
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar client:load />
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 flex flex-col">
      <slot />
    </main>
    <Footer lang={langAttribute} />
  </body>
</html>
