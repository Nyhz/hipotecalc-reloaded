---
import { ClientRouter } from "astro:transitions";
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../style/globals.css';
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calculadora Hipotecaria</title>
    <meta name="description" content="Calculadora hipotecaria, de alquiler e ITP para España. Herramientas financieras precisas y profesionales." />
    <meta name="keywords" content="calculadora hipoteca, calculadora alquiler, calculadora ITP, finanzas, España" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap">
    <ClientRouter />  
  </head>
  <body class="bg-white text-black min-h-screen flex flex-col">
    <Navbar />
    <main class="flex-1 flex flex-col items-center justify-start w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
