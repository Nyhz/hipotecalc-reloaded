---
import { ClientRouter } from "astro:transitions";
import Navbar from '../components/Navbar.tsx';
import Footer from '../components/Footer.astro';
import '../style/globals.css';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonicalURL?: string;
}

const { 
  title = "Calculadora Hipotecaria - España | Herramientas Financieras",
  description = "Calculadora hipotecaria, de alquiler e ITP para España. Herramientas financieras precisas y profesionales para calcular tu hipoteca, impuestos y más.",
  keywords = "calculadora hipoteca, calculadora alquiler, calculadora ITP, finanzas, España, euribor, impuestos, vivienda",
  ogImage = "/og-image.svg",
  canonicalURL = 'https://hipotecalc.com'
} = Astro.props;
---
<html lang="es">
  <head>
    <!-- Start cookieyes banner with error handling --> 
    <script id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/9f0e347f752a5c179f39585d/script.js" onerror="window.cookieYesBlocked = true;"></script> 
    <!-- End cookieyes banner -->
    
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    
    <!-- Basic SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Hipotecalc" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Hipotecalc" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    
    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="theme-color" content="#2563eb" />
    
    <!-- Resource hints for better performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Optimized font loading with swap for better performance -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    
    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Calculadora Hipotecaria España",
      "description": "Calculadora hipotecaria profesional para España con cálculo de ITP, impuestos y análisis del Euribor",
      "url": "https://hipotecalc.com",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web Browser",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "creator": {
        "@type": "Organization",
        "name": "Hipotecalc"
      },
      "keywords": "calculadora hipoteca, ITP, impuestos, vivienda, España, euribor"
    }
    </script>

    <!-- Google Analytics - Managed by CookieYes -->
    <script is:inline>
      // Initialize dataLayer and gtag function immediately
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      
      // Set default consent to denied
      gtag('consent', 'default', {
        'analytics_storage': 'denied'
      });
      
      // Flag to track if GA script is loaded
      window.gaScriptLoaded = false;
      window.lastAnalyticsState = null;
      
      // Function to parse CookieYes consent cookie
      function parseCookieYesConsent() {
        var cookies = document.cookie.split(';');
        var consentCookie = null;
        
        for (var i = 0; i < cookies.length; i++) {
          var cookie = cookies[i].trim();
          if (cookie.startsWith('cookieyes-consent=')) {
            consentCookie = cookie.substring('cookieyes-consent='.length);
            break;
          }
        }
        
        if (!consentCookie) {
          return null;
        }
        
        var consentData = {};
        var parts = consentCookie.split(',');
        
        for (var j = 0; j < parts.length; j++) {
          var keyValue = parts[j].split(':');
          if (keyValue.length === 2) {
            consentData[keyValue[0]] = keyValue[1];
          }
        }
        
        return consentData;
      }
      
      // Function to delete GA cookies
      function deleteGACookies() {
        var domain = window.location.hostname;
        var cookiesToDelete = ['_ga', '_ga_G-RCYZ4N1WPT', '_gid', '_gat_gtag_G_RCYZ4N1WPT'];
        
        cookiesToDelete.forEach(function(cookieName) {
          // Delete for current domain
          document.cookie = cookieName + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=' + domain + ';';
          // Delete for parent domain (if subdomain)
          document.cookie = cookieName + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=.' + domain + ';';
          // Delete without domain
          document.cookie = cookieName + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        });
      }
      
      // Function to load Google Analytics script
      function loadGoogleAnalytics() {
        if (!window.gaScriptLoaded && !document.querySelector('script[src*="googletagmanager.com/gtag/js"]')) {
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=G-RCYZ4N1WPT';
          script.onload = function() {
            window.gaScriptLoaded = true;
            initializeGA();
          };
          document.head.appendChild(script);
        } else if (window.gaScriptLoaded) {
          initializeGA();
        }
      }
      
      // Function to initialize GA with consent
      function initializeGA() {
        gtag('js', new Date());
        gtag('config', 'G-RCYZ4N1WPT', {
          'analytics_storage': 'granted',
          'anonymize_ip': true,
          'send_page_view': true
        });
      }
      
      // Function to enable analytics
      function enableAnalytics() {
        gtag('consent', 'update', {
          'analytics_storage': 'granted'
        });
        loadGoogleAnalytics();
      }
      
      // Function to disable analytics
      function disableAnalytics() {
        gtag('consent', 'update', {
          'analytics_storage': 'denied'
        });
        // Delete existing GA cookies
        deleteGACookies();
      }
      
      // Function to check and handle consent changes
      function handleConsentChange() {
        var consent = parseCookieYesConsent();
        
        if (!consent) {
          return;
        }
        
        var analyticsConsent = consent.analytics;
        
        // Only act if consent state has changed
        if (window.lastAnalyticsState !== analyticsConsent) {
          window.lastAnalyticsState = analyticsConsent;
          
          if (analyticsConsent === 'yes') {
            enableAnalytics();
          } else if (analyticsConsent === 'no') {
            disableAnalytics();
          }
        }
      }
      
      // Make function globally accessible for debugging
      window.handleConsentChange = handleConsentChange;
      window.parseCookieYesConsent = parseCookieYesConsent;
      
      // Monitor cookie changes using polling (since cookie change events don't exist)
      function startCookieMonitoring() {
        // If CookieYes is blocked, don't start monitoring
        if (window.cookieYesBlocked) {
          return;
        }
        
        // Check immediately
        handleConsentChange();
        
        // Then poll every 500ms for changes
        setInterval(handleConsentChange, 500);
      }
      
      // Start monitoring when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startCookieMonitoring);
      } else {
        startCookieMonitoring();
      }
    </script>
    
    <!-- Debug script for CookieYes + GA integration (silent mode) -->
    <script is:inline>
      // Silent debug function for development use
      window.debugGA = function() {
        var consent = null;
        var cookies = document.cookie.split(';');
        
        for (var i = 0; i < cookies.length; i++) {
          var cookie = cookies[i].trim();
          if (cookie.startsWith('cookieyes-consent=')) {
            var consentCookie = cookie.substring('cookieyes-consent='.length);
            var consentData = {};
            var parts = consentCookie.split(',');
            
            for (var j = 0; j < parts.length; j++) {
              var keyValue = parts[j].split(':');
              if (keyValue.length === 2) {
                consentData[keyValue[0]] = keyValue[1];
              }
            }
            consent = consentData;
            break;
          }
        }
        
        return {
          blocked: !!window.cookieYesBlocked,
          consent: consent,
          analytics: consent && consent.analytics === 'yes',
          gaLoaded: !!window.gaScriptLoaded,
          cookies: document.cookie.split(';').filter(c => c.trim().startsWith('_ga')).length
        };
      };
      
      // Silent test function
      window.testConsentChange = function() {
        if (typeof window.handleConsentChange === 'function') {
          window.handleConsentChange();
        }
      };
    </script>
    
    <!-- Font loading optimization to prevent layout shifts -->
    <script>
      // Add font-display: swap fallback for older browsers
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(function() {
          document.documentElement.classList.add('fonts-loaded');
        });
      }
      
      // Preemptively set font style to prevent FOIT
      const style = document.createElement('style');
      style.textContent = `
        .font-loading-stable {
          font-synthesis: none;
          font-kerning: auto;
          text-rendering: optimizeLegibility;
        }
        .fonts-loaded .font-loading-stable {
          font-synthesis: weight style;
        }
      `;
      document.head.appendChild(style);
    </script>
    
    <ClientRouter />  
  </head>
  <body class="bg-gradient-to-b from-blue-50 to-white text-black min-h-screen flex flex-col">
    <Navbar client:load />
    <main class="flex-1 flex flex-col items-center justify-start w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
