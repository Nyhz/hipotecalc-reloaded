---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import PageTracking from '../../components/PageTracking.tsx';
import Byline from '../../components/seo/Byline.astro';
import { fechaPublicacion } from '../../utils/ultima-modificacion';
import { resolverAutoria, refSchema } from '../../data/authors';
import ITPStandalone from '../../components/calculadora-itp/ITPStandalone';
import MortgageCalculator from '../../components/calculadora-hipotecaria/MortgageCalculator';
import FAQSection from '../../components/seo/FAQSection.astro';

export async function getStaticPaths() {
  const guias = await getCollection('itp');
  return guias.map((guia) => ({
    params: { slug: guia.id },
    props: { guia },
  }));
}

const todasLasGuias = (await getCollection('itp')).sort((a, b) =>
  a.data.comunidad.localeCompare(b.data.comunidad, 'es')
);

const { guia } = Astro.props;
const { Content } = await render(guia);

const formatDate = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const SITE_BASE = 'https://www.hipotecalc.com';
const canonical = `${SITE_BASE}/itp/${guia.id}`;
// Mapa con la región resaltada (scripts/itp-map/make_region_maps.py)
const mapaRegion = `/img/itp/es/${guia.id}.png`;

// Autoría: frontmatter > defaults de src/data/authors.ts — el schema debe
// reflejar exactamente lo que muestra el byline visible
const autoria = resolverAutoria('itp', guia.data);
// Fecha real de publicación: primer commit del fichero de contenido
const publicadoGit = fechaPublicacion(`src/content/guias/itp/${guia.id}.md`);
// nunca posterior a updatedDate (p. ej. traducciones añadidas a git después
// de la fecha declarada): datePublished ≤ dateModified siempre
const publicado = publicadoGit && publicadoGit < guia.data.updatedDate ? publicadoGit : guia.data.updatedDate;

const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": guia.data.title,
  "description": guia.data.description,
  "url": canonical,
  "datePublished": publicado.toISOString(),
  "dateModified": guia.data.updatedDate.toISOString(),
  "author": refSchema(autoria.autor, 'es'),
  ...(autoria.revisor ? { "reviewedBy": refSchema(autoria.revisor, 'es') } : {}),
  "inLanguage": "es",
  "publisher": { "@id": `${SITE_BASE}/#organization` },
  "mainEntityOfPage": canonical,
});

// Nombre corto para encabezados de sección
const nombreCorto = guia.id === 'ceuta-melilla' ? 'Ceuta y Melilla' : guia.data.comunidad;
const altMapa = `Mapa del ITP por comunidad autónoma en 2026 con ${nombreCorto} resaltada: ${guia.data.tipoGeneral} frente al resto de España, sobre una vivienda usada de 200.000 €`;

// FAQ con marcado FAQPage (bloques "Otras preguntas" de Google). Respuestas
// construidas desde los datos verificados del frontmatter, con las
// particularidades forales y de imposición indirecta de cada territorio.
const esForal = ['Navarra', 'País Vasco'].includes(guia.data.comunidad);
const tipoEnFrase = guia.data.tipoGeneral.charAt(0).toLowerCase() + guia.data.tipoGeneral.slice(1);

// Experimento SEO (jul-2026): <title> con el dato SOLO en estas 3 comunidades.
// El resto conserva su title y actúa como grupo de control — no ampliar la
// lista sin revisar los resultados del experimento. Cifras tomadas del
// frontmatter/datos verificados de cada guía.
const TITULOS_CON_DATO: Record<string, string> = {
  'castilla-y-leon': 'ITP en Castilla y León 2026: 8 % general y reducido del 4 % | Hipotecalc',
  'comunidad-valenciana': 'ITP en la Comunitat Valenciana 2026: 9 % general y reducido del 6 % | Hipotecalc',
  'pais-vasco': 'ITP en el País Vasco 2026: 4 % vivienda (7 % general) y reducido del 2,5 % | Hipotecalc',
};
// Experimento SEO (ago-2026): <title> con promesa de cálculo en 6 páginas.
// Grupos: TRATAMIENTO (estas 6) · CONTROL intacto (cantabria, extremadura,
// la-rioja, navarra, ceuta-melilla) · el brazo "dato en el título" de julio
// (castilla-y-leon, comunidad-valenciana, pais-vasco) sigue tal cual ·
// las 5 de más volumen reciben el cambio de description, no de título.
const TITULOS_CALCULO: Record<string, string> = {
  'galicia': 'ITP en Galicia 2026: calcula lo que pagarás por tu vivienda | Hipotecalc',
  'aragon': 'ITP en Aragón 2026: calcula lo que pagarás por tu vivienda | Hipotecalc',
  'murcia': 'ITP en Murcia 2026: calcula lo que pagarás por tu vivienda | Hipotecalc',
  'canarias': 'ITP en Canarias 2026: calcula lo que pagarás por tu vivienda | Hipotecalc',
  'castilla-la-mancha': 'ITP en Castilla-La Mancha 2026: calcula lo que pagarás por tu vivienda | Hipotecalc',
  'asturias': 'ITP en Asturias 2026: calcula lo que pagarás por tu vivienda | Hipotecalc',
};
const tituloPagina = TITULOS_CON_DATO[guia.id] ?? TITULOS_CALCULO[guia.id] ?? `${guia.data.title} | Hipotecalc`;

// Párrafo-respuesta bajo el H1: contesta la consulta principal en prosa con
// los datos del frontmatter. Si el resumen arranca repitiendo el tipo general
// (o la tarifa), se omite esa primera cláusula para no duplicar.
const tipoParaRespuesta = /^\d/.test(guia.data.tipoGeneral)
  ? `del ${guia.data.tipoGeneral}`
  : `de ${tipoEnFrase}`;
const clausulasResumen = guia.data.resumen.split('; ');
const matizResumen =
  clausulasResumen.length > 1 && /general|tarifa/i.test(clausulasResumen[0])
    ? clausulasResumen.slice(1).join('; ')
    : guia.data.resumen;
const articuloNombre =
  guia.id === 'pais-vasco' ? 'el ' : guia.id === 'comunidad-valenciana' ? 'la ' : '';
const parrafoRespuesta = `En ${articuloNombre}${nombreCorto}, el ITP por la compra de una vivienda de segunda mano en 2026 es ${tipoParaRespuesta}, con estos tipos reducidos y bonificaciones principales: ${matizResumen}.`;

const impuestoObraNueva =
  guia.id === 'canarias'
    ? 'No. La primera transmisión de una vivienda nueva en Canarias no paga ITP ni IVA: tributa por el IGIC (Impuesto General Indirecto Canario). El ITP solo grava las viviendas de segunda mano.'
    : guia.id === 'ceuta-melilla'
      ? 'No. La vivienda nueva en Ceuta y Melilla no paga ITP ni IVA: tributa por el IPSI (Impuesto sobre la Producción, los Servicios y la Importación). El ITP solo grava las viviendas de segunda mano.'
      : `No. La vivienda nueva comprada al promotor tributa por IVA al 10 % (4 % si es VPO de régimen especial) más Actos Jurídicos Documentados. El ITP solo grava las viviendas de segunda mano en ${nombreCorto}.`;

const faqItems = [
  {
    question: `¿Cuánto ITP se paga en ${nombreCorto} en 2026?`,
    answer: `El tipo general vigente es ${tipoEnFrase}. Además existen tipos reducidos y bonificaciones: ${guia.data.resumen}. Cada beneficio tiene requisitos detallados que se explican en esta guía con su cita legal.`,
  },
  {
    question: `¿Quién paga el ITP y qué plazo hay en ${nombreCorto}?`,
    answer: 'El ITP lo paga siempre el comprador de la vivienda usada, mediante autoliquidación ante la administración tributaria correspondiente. El plazo habitual es de 30 días hábiles o un mes desde la firma de la escritura; el modelo y el plazo exactos se detallan en esta guía.',
  },
  {
    question: `¿Sobre qué valor se calcula el ITP en ${nombreCorto}?`,
    answer: esForal
      ? `${nombreCorto} tiene régimen foral y aplica sus propias reglas de valoración, que no siguen el sistema estatal del valor de referencia de Catastro. El detalle está en el apartado de base imponible de esta guía.`
      : 'Sobre el valor de referencia de Catastro o el precio de compraventa si es mayor (art. 10 del TRLITPAJD, desde 2022). Pagar un precio inferior al valor de referencia no reduce el impuesto.',
  },
  {
    question: `¿La vivienda nueva paga ITP en ${nombreCorto}?`,
    answer: impuestoObraNueva,
  },
];
---
<Layout
  title={tituloPagina}
  description={guia.data.description}
  pageType="legal"
  ogImage={`${SITE_BASE}${mapaRegion}`}
  ogImageAlt={altMapa}
  ogType="article"
>
  <PageTracking client:load pagePath={`/itp/${guia.id}`} pageTitle={guia.data.title} />
  <script type="application/ld+json" set:html={articleSchema} />

  <Breadcrumbs items={[
    { name: 'Inicio', href: '/' },
    { name: 'Guías', href: '/guias' },
    { name: 'ITP por comunidades', href: '/itp' },
    { name: nombreCorto, href: `/itp/${guia.id}` }
  ]} />

  <article class="w-full max-w-3xl mx-auto py-10">
    <header class="mb-8">
      <span class="eyebrow">Guía del ITP · {nombreCorto}</span>
      <h1 class="font-heading text-3xl md:text-4xl font-semibold tracking-[-1px] text-ink mt-4 mb-3">
        {guia.data.title}
      </h1>
      <p class="text-ink-soft leading-relaxed mb-3">{parrafoRespuesta}</p>
      <Byline autoria={autoria} lang="es" updated={guia.data.updatedDate} policyLinks />
    </header>
    <section id="calculadora-itp" class="mb-10">
      <h2 class="font-heading text-xl font-semibold text-ink mb-1">Calcula tu ITP en {nombreCorto}</h2>
      <p class="text-sm text-ink-soft mb-4">
        Pon el precio y tus circunstancias: te decimos lo que pagas, con las bonificaciones
        de {nombreCorto} ya aplicadas.
      </p>
      <ITPStandalone client:load lang="es" initialComunidad={guia.data.comunidad} />
    </section>

    <figure class="mb-10">
      <img src={mapaRegion} alt={altMapa} width="1800" height="1238" loading="lazy" decoding="async" class="w-full h-auto rounded-lg" />
    </figure>

    <div class="pl-card p-5 mb-10 border-l-4 border-lime">
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-2">
        <span class="font-data text-[11px] uppercase tracking-widest text-ink-soft">Tipo general 2026</span>
        <span class="font-heading text-2xl font-bold text-ink">{guia.data.tipoGeneral}</span>
      </div>
      <a href="#calculadora" class="inline-block mt-1 text-sm font-medium text-brand-blue underline">
        Simula la hipoteca completa en {nombreCorto} ↓
      </a>
    </div>

    <div class="text-ink-soft leading-relaxed space-y-4
      [&>h2]:font-heading [&>h2]:text-2xl [&>h2]:font-semibold [&>h2]:text-ink [&>h2]:mt-10 [&>h2]:mb-3
      [&>h3]:font-heading [&>h3]:text-xl [&>h3]:font-semibold [&>h3]:text-ink [&>h3]:mt-8 [&>h3]:mb-2
      [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:space-y-1
      [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:space-y-1
      [&_a]:underline [&_a]:text-brand-blue [&_a]:break-words
      [&_table]:w-full [&_table]:text-sm [&_table]:my-4 [&_th]:text-left [&_th]:py-2 [&_th]:px-2 [&_th]:border-b [&_th]:border-line [&_td]:py-2 [&_td]:px-2 [&_td]:border-b [&_td]:border-line
      [&>blockquote]:border-l-4 [&>blockquote]:border-lime [&>blockquote]:pl-4 [&>blockquote]:italic
      [&_strong]:text-ink">
      <Content />
    </div>
  </article>

  <section id="calculadora" class="w-full py-14">
    <div class="text-center mb-8">
      <span class="eyebrow">Calculadora precargada</span>
      <h2 class="font-heading text-2xl md:text-3xl font-semibold text-ink mt-3 mb-3">
        Calcula tu hipoteca y tu ITP en {nombreCorto}
      </h2>
      <p class="text-ink-soft max-w-2xl mx-auto">
        La calculadora ya tiene seleccionada la comunidad: introduce el precio de la vivienda
        y tu ahorro, y usa «Calcula tu ITP» para aplicar las bonificaciones de tu caso.
      </p>
    </div>
    <MortgageCalculator client:visible lang="es" initialComunidad={guia.data.comunidad} />
  </section>

  <FAQSection
    title={`Preguntas frecuentes sobre el ITP en ${nombreCorto}`}
    items={faqItems}
  />

  <section class="w-full max-w-5xl mx-auto py-10">
    <h2 class="font-heading text-2xl font-semibold text-ink mb-2">
      ¿Comparas con otra comunidad?
    </h2>
    <p class="text-ink-soft mb-6 max-w-3xl">
      El mismo piso puede pagar un impuesto muy distinto a pocos kilómetros:
      consulta el ITP vigente en el resto de comunidades.
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {todasLasGuias
        .filter((otra) => otra.id !== guia.id)
        .map((otra) => (
          <a href={`/itp/${otra.id}`} class="pl-card pl-card-hover p-3 flex flex-col gap-0.5">
            <span class="font-medium text-ink text-sm">
              {otra.id === 'ceuta-melilla' ? 'Ceuta y Melilla' : otra.data.comunidad}
            </span>
            <span class="font-data text-xs text-ink-soft">{otra.data.tipoGeneral}</span>
          </a>
        ))}
    </div>
  </section>

  <footer class="w-full max-w-3xl mx-auto pb-10">
    <div class="pt-6 border-t border-line">
      <p class="text-xs text-ink-soft">
        Esta guía es contenido informativo, no asesoramiento fiscal. Normativa verificada a
        {formatDate(guia.data.updatedDate)} con las fuentes oficiales enlazadas; los tipos pueden
        cambiar. Consulta el <a href="/disclaimer-financiero" class="underline text-brand-blue">disclaimer financiero</a>.
      </p>
      <a href="/itp" class="inline-block mt-4 text-sm font-medium text-brand-blue">← Ver el ITP en todas las comunidades</a>
    </div>
  </footer>
</Layout>
