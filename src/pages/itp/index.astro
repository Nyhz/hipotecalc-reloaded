---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import PageTracking from '../../components/PageTracking.tsx';
import FAQSection from '../../components/seo/FAQSection.astro';

const guias = (await getCollection('itp')).sort((a, b) =>
  a.data.comunidad.localeCompare(b.data.comunidad, 'es')
);

const title = 'ITP por comunidades autónomas 2026: guía completa | Hipotecalc';
const description =
  'Cuánto ITP se paga al comprar vivienda usada en cada comunidad autónoma en 2026: tipos generales, reducciones y bonificaciones, verificados con fuentes oficiales.';

const nombreCorto = (guia: (typeof guias)[number]) =>
  guia.id === 'ceuta-melilla' ? 'Ceuta y Melilla' : guia.data.comunidad;
---
<Layout title={title} description={description} pageType="legal"
  ogImage="https://www.hipotecalc.com/img/itp-mapa-espana-2026.png"
  ogImageAlt="Mapa de España con el ITP efectivo por comunidad autónoma en 2026 sobre una vivienda usada de 200.000 €: del 3 % de Ceuta y Melilla al 10 % de Cataluña">
  <PageTracking client:load pagePath="/itp" pageTitle={title} />

  <Breadcrumbs items={[
    { name: 'Inicio', href: '/' },
    { name: 'Guías', href: '/guias' },
    { name: 'ITP por comunidades', href: '/itp' }
  ]} />

  <div class="w-full max-w-5xl mx-auto py-10">
    <header class="text-center mb-10">
      <span class="eyebrow">Guía del ITP · España 2026</span>
      <h1 class="font-heading text-3xl md:text-4xl lg:text-[44px] font-semibold tracking-[-1px] text-ink mt-4 mb-4">
        El ITP en cada comunidad autónoma
      </h1>
      <p class="text-ink-soft max-w-3xl mx-auto text-base md:text-lg">
        El Impuesto de Transmisiones Patrimoniales es el mayor gasto al comprar una vivienda
        de segunda mano, y cada comunidad aplica tipos y bonificaciones distintos: del 3 %
        efectivo de Ceuta y Melilla al 13 % de los tramos altos en Cataluña o Baleares.
        Elige tu comunidad y consulta los tipos vigentes, verificados con fuentes oficiales.
      </p>
    </header>

    <figure class="mb-10 max-w-4xl mx-auto">
      <img src="/img/itp-mapa-espana-2026.png" alt="Mapa de España con el ITP efectivo por comunidad autónoma en 2026 sobre una vivienda usada de 200.000 €: del 3 % de Ceuta y Melilla al 10 % de Cataluña" width="1800" height="1238" loading="eager" fetchpriority="high" decoding="async" class="w-full h-auto rounded-lg" />
    </figure>

    <div class="pl-card p-5 mb-10 text-sm text-ink-soft leading-relaxed">
      <p>
        <strong class="text-ink">Dos reglas comunes a toda España:</strong> el impuesto lo paga
        siempre el comprador, y desde 2022 la base imponible es el
        <strong class="text-ink"> valor de referencia de Catastro</strong> —o el precio pactado si
        es mayor—, no el precio sin más (art. 10 del TRLITPAJD). Navarra y País Vasco aplican sus
        propias reglas forales de valoración. Si la vivienda es nueva, no se paga ITP sino IVA
        del 10 %: puedes comparar ambos casos en la
        <a href="/calculadora-hipotecaria" class="underline text-brand-blue">calculadora hipotecaria</a>.
      </p>
    </div>

    <div class="overflow-x-auto pl-card p-2 md:p-4 mb-12">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-line font-data text-[11px] uppercase tracking-wide text-ink-soft">
            <th class="text-left py-3 px-3">Territorio</th>
            <th class="text-left py-3 px-3">Tipo general 2026</th>
            <th class="text-left py-3 px-3 hidden md:table-cell">Principales reducciones y bonificaciones</th>
            <th class="text-right py-3 px-3">Guía</th>
          </tr>
        </thead>
        <tbody>
          {guias.map((guia) => (
            <tr class="border-b border-line hover:bg-paper-2/60 transition-colors">
              <td class="py-3 px-3 font-medium text-ink whitespace-nowrap">
                <a href={`/itp/${guia.id}`} class="hover:text-brand-blue transition-colors">{nombreCorto(guia)}</a>
              </td>
              <td class="py-3 px-3 text-ink whitespace-nowrap">{guia.data.tipoGeneral}</td>
              <td class="py-3 px-3 text-ink-soft hidden md:table-cell">{guia.data.resumen}</td>
              <td class="py-3 px-3 text-right">
                <a href={`/itp/${guia.id}`} class="text-brand-blue font-medium whitespace-nowrap">Ver guía →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="text-xs text-ink-soft mb-12 max-w-3xl">
      Cuadro orientativo elaborado a partir de los textos consolidados del BOE, los boletines
      autonómicos y el libro «Tributación Autonómica. Medidas 2026» del Ministerio de Hacienda.
      Cada beneficio tiene requisitos detallados (límites de renta, patrimonio, superficie,
      plazos de ocupación…) que se explican en la guía de cada comunidad con su cita legal.
    </p>
  </div>

  <FAQSection
    title="Preguntas frecuentes sobre el ITP"
    items={[
      {
        question: "¿Quién paga el ITP y cuándo?",
        answer: "El ITP lo paga siempre el comprador de la vivienda usada, mediante autoliquidación (modelo 600 en la mayoría de comunidades) en el plazo de 30 días hábiles o un mes desde la firma de la escritura, según la comunidad."
      },
      {
        question: "¿Sobre qué cantidad se calcula el ITP?",
        answer: "Desde 2022, sobre el valor de referencia de Catastro o el precio de compraventa si es mayor. Pagar un precio inferior al valor de referencia no reduce el impuesto. En Navarra y País Vasco rigen reglas forales propias de valoración."
      },
      {
        question: "¿Qué comunidad tiene el ITP más bajo en 2026?",
        answer: "Entre las comunidades de régimen común, Madrid aplica el tipo general más bajo (6 %), seguida de Canarias (6,5 %). En Ceuta y Melilla el tipo efectivo es del 3 % gracias a la bonificación estatal del 50 %, y en el País Vasco las viviendas tributan al 4 %."
      },
      {
        question: "¿La vivienda nueva paga ITP?",
        answer: "No. La primera transmisión de una vivienda nueva tributa por IVA al 10 % (4 % si es VPO de régimen especial) más el impuesto de Actos Jurídicos Documentados. El ITP solo grava las viviendas de segunda mano."
      }
    ]}
  />
</Layout>
