---
import Layout from '../layouts/Layout.astro';
import RentalCalculator from '../components/calculadora-alquiler/RentalCalculator.tsx';
import PageTracking from '../components/PageTracking.tsx';
import { t } from '../utils/i18n';
---

<Layout 
  title={t('seo.rental.title')} 
  description={t('seo.rental.description')}
  keywords={t('seo.rental.keywords')}
>
  <PageTracking client:load pagePath="/calculadora-alquiler" pageTitle={t('seo.rental.title')} />
  <main class="w-full max-w-7xl mx-auto py-8 ambient-section rounded-3xl">
    <div class="ambient-content w-full">
      <!-- Header -->
      <div class="text-center mb-6 reveal-up">
        <span class="inline-flex rounded-full border border-blue-200 bg-blue-50 text-blue-700 px-4 py-1 text-xs font-semibold uppercase tracking-wider">
          {t('rental.title')}
        </span>
        <h1 class="font-heading text-4xl font-bold text-slate-900 mt-4 mb-3">
          {t('rental.hero.title')}
        </h1>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          {t('rental.hero.description')}
        </p>
      </div>

      <!-- Calculadora -->
      <div class="reveal-up reveal-delay-1">
        <RentalCalculator client:load lang="es" />
      </div>
    </div>
  </main>
</Layout> 
