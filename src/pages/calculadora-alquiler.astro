---
import Layout from '../layouts/Layout.astro';
import Byline from '../components/seo/Byline.astro';
import { resolverAutoria } from '../data/authors';
import { ultimaModificacion, fechaPublicacion } from '../utils/ultima-modificacion';
import RentalCalculator from '../components/calculadora-alquiler/RentalCalculator.tsx';
import PageTracking from '../components/PageTracking.tsx';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import FAQSection from '../components/seo/FAQSection.astro';
import { t } from '../utils/i18n';
const autoria = resolverAutoria('calculadora');
const actualizado = ultimaModificacion('src/pages/calculadora-alquiler.astro');
const publicado = fechaPublicacion('src/pages/calculadora-alquiler.astro');

---

<Layout autoria={autoria} datePublished={publicado} dateModified={actualizado}
  title={t('seo.rental.title')}
  description={t('seo.rental.description')}
>
  <PageTracking client:load pagePath="/calculadora-alquiler" pageTitle={t('seo.rental.title')} />

  <Breadcrumbs items={[
    { name: 'Inicio', href: '/' },
    { name: 'Calculadora de Alquiler', href: '/calculadora-alquiler' }
  ]} />

  <div class="w-full py-8">
    <div class="text-center mb-8 reveal-up">
      <span class="eyebrow">{t('rental.title')}</span>
      <h1 class="font-heading text-3xl md:text-4xl lg:text-[44px] font-semibold tracking-[-1px] text-ink mt-4 mb-3">
        {t('rental.hero.title')}
      </h1>
      <div class="mt-2 mb-1"><Byline autoria={autoria} lang="es" updated={actualizado} /></div>
      <p class="text-ink-soft max-w-3xl mx-auto text-base md:text-lg">{t('rental.hero.description')}</p>
    </div>
    <div class="reveal-up reveal-delay-1">
      <RentalCalculator client:load lang="es" />
    </div>
  </div>

  <section class="w-full max-w-4xl mx-auto py-14">
    <span class="eyebrow">Guía rápida</span>
    <h2 class="font-heading text-2xl md:text-3xl font-semibold text-ink mt-3 mb-6">
      ¿Cómo calcular la rentabilidad de un alquiler?
    </h2>
    <div class="text-ink-soft space-y-4 leading-relaxed md:columns-2 md:gap-10 [&>p]:break-inside-avoid">
      <p>
        Nuestra <strong>calculadora de alquiler</strong> te permite analizar la rentabilidad de una inversión inmobiliaria en España.
        Introduce el precio de compra, los costes asociados, el alquiler mensual esperado y los gastos recurrentes
        para obtener métricas clave como el <strong>ROI anual</strong>, el <strong>cash flow mensual</strong> y el <strong>tiempo de recuperación</strong> de tu inversión.
      </p>
      <p>
        La herramienta tiene en cuenta la financiación hipotecaria, impuestos de la propiedad, seguros, mantenimiento
        y gestión para darte una visión realista de la <strong>rentabilidad neta</strong> de tu inversión.
      </p>
    </div>
  </section>

  <FAQSection
    title="Preguntas Frecuentes sobre Inversión en Alquiler"
    items={[
      {
        question: "¿Qué rentabilidad se considera buena para un alquiler en España?",
        answer: "Una rentabilidad bruta del 5-7% se considera buena en España. La rentabilidad neta (descontando gastos, impuestos y vacantes) suele estar entre el 3-5%. En grandes ciudades como Madrid o Barcelona la rentabilidad suele ser menor pero con mayor seguridad, mientras que en ciudades medianas puede ser más alta."
      },
      {
        question: "¿Qué es el cash flow en una inversión inmobiliaria?",
        answer: "El cash flow es la diferencia entre los ingresos por alquiler y todos los gastos asociados (hipoteca, impuestos, seguros, mantenimiento, gestión). Un cash flow positivo significa que el alquiler cubre todos los gastos y genera beneficio mensual."
      },
      {
        question: "¿Qué gastos debo tener en cuenta al comprar para alquilar?",
        answer: "Debes considerar: la cuota hipotecaria, el IBI y otros impuestos locales, el seguro del hogar, el mantenimiento y reparaciones (se estima un 1-2% del valor anual), la gestión de la propiedad si delegas, los periodos de vacante sin inquilino, y la declaración de la renta por los ingresos del alquiler."
      },
      {
        question: "¿Cuánto tarda en recuperarse la inversión de un piso de alquiler?",
        answer: "El tiempo de recuperación depende del precio de compra, la entrada aportada y la rentabilidad neta. En España, con una rentabilidad media del 4-5% neto, recuperar la entrada puede tardar entre 8 y 15 años. Nuestra calculadora te muestra el break-even exacto según tus datos."
      }
    ]}
  />
</Layout>
