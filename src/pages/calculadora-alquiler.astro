---
import Layout from '../layouts/Layout.astro';
import RentalCalculator from '../components/calculadora-alquiler/RentalCalculator.tsx';
---

<Layout title="Calculadora de Alquiler - Análisis de Rentabilidad Inmobiliaria" description="Calcula la rentabilidad de tu inversión inmobiliaria. Analiza ROI, cash flow mensual, break even y más métricas clave para tomar decisiones informadas.">
  <main class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-7xl mx-auto px-4">
      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-blue-900 mb-4">
          Calculadora de Alquiler
        </h1>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Analiza la rentabilidad de tu inversión inmobiliaria. Calcula ROI, cash flow mensual, 
          tiempo de recuperación y más métricas clave para tomar decisiones informadas.
        </p>
      </div>

      <!-- Calculadora -->
      <RentalCalculator client:load />
    </div>
  </main>
</Layout> 