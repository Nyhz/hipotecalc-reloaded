---
import Layout from '../layouts/Layout.astro';
import RentalCalculator from '../components/calculadora-alquiler/RentalCalculator.tsx';
import PageTracking from '../components/PageTracking.tsx';
import { t } from '../utils/i18n';
---

<Layout 
  title={t('seo.rental.title')} 
  description={t('seo.rental.description')}
  keywords={t('seo.rental.keywords')}
>
  <PageTracking client:load pagePath="/calculadora-alquiler" pageTitle={t('seo.rental.title')} />
  <main class="min-h-screen py-8">
    <div class="max-w-7xl mx-auto px-4">
      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-blue-900 mb-4">
          {t('rental.hero.title')}
        </h1>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          {t('rental.hero.description')}
        </p>
      </div>

      <!-- Calculadora -->
      <RentalCalculator client:load lang="es" />
    </div>
  </main>
</Layout> 