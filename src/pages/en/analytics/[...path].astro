---
import AnalyticsPage from '../../../components/analytics/AnalyticsPage.astro';
import { pages } from '../../../analytics/pages';
export function getStaticPaths() {
  return pages('en').map(page=>({params:{path:page.path.replace(/^\/en\/analytics\/?/,'')||undefined},props:{page}}));
}
const {page}=Astro.props;
---
<AnalyticsPage page={page}/>
