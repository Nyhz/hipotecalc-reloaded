---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import PageTracking from '../../../components/PageTracking.tsx';
import Byline from '../../../components/seo/Byline.astro';
import { resolverAutoria, refSchema } from '../../../data/authors';
import FAQSection from '../../../components/seo/FAQSection.astro';
import MortgageCalculator from '../../../components/calculadora-hipotecaria/MortgageCalculator';
import ITPStandalone from '../../../components/calculadora-itp/ITPStandalone';
import PrestamoMaximoCalculator from '../../../components/prestamo/PrestamoMaximoCalculator';
import GastosCompraventaCalculator from '../../../components/gastos/GastosCompraventaCalculator';

export async function getStaticPaths() {
  const guias = await getCollection('guiasEn');
  return guias.map((guia) => ({
    params: { slug: guia.id },
    props: { guia },
  }));
}

const { guia } = Astro.props;
const { Content } = await render(guia);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });

const SITE_BASE = 'https://www.hipotecalc.com';
const canonical = `${SITE_BASE}/en/guides/${guia.id}`;

// Autoría: frontmatter > defaults de src/data/authors.ts — el schema debe
// reflejar exactamente lo que muestra el byline visible
const autoria = resolverAutoria('guia', guia.data);

const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": guia.data.title,
  "description": guia.data.description,
  "url": canonical,
  "dateModified": guia.data.updatedDate.toISOString(),
  "author": refSchema(autoria.autor, 'en'),
  ...(autoria.revisor ? { "reviewedBy": refSchema(autoria.revisor, 'en') } : {}),
  "inLanguage": "en",
  "publisher": { "@id": `${SITE_BASE}/#organization` },
  "mainEntityOfPage": canonical,
});

const tituloCalculadora = {
  hipoteca: 'Simulate your mortgage with your own numbers',
  itp: "Calculate your region's ITP",
  prestamo: 'How much would a bank lend you?',
  gastos: 'Calculate your full purchase costs',
}[guia.data.calculadora ?? 'hipoteca'];
---
<Layout
  ogImage={guia.data.ogImage ? `${SITE_BASE}${guia.data.ogImage}` : undefined}
  title={`${guia.data.title} | Hipotecalc`}
  description={guia.data.description}
  pageType="legal"
>
  <PageTracking client:load pagePath={`/en/guides/${guia.id}`} pageTitle={guia.data.title} />
  <script type="application/ld+json" set:html={articleSchema} />

  <Breadcrumbs items={[
    { name: 'Home', href: '/en' },
    { name: 'Guides', href: '/en/guides' },
    { name: guia.data.title, href: `/en/guides/${guia.id}` }
  ]} />

  <article class="w-full max-w-3xl mx-auto py-10">
    <header class="mb-8">
      <span class="eyebrow">Guide</span>
      <h1 class="font-heading text-3xl md:text-4xl font-semibold tracking-[-1px] text-ink mt-4 mb-3">
        {guia.data.title}
      </h1>
      <Byline autoria={autoria} lang="en" updated={guia.data.updatedDate} policyLinks />
    </header>

    <div class="text-ink-soft leading-relaxed space-y-4
      [&>h2]:font-heading [&>h2]:text-2xl [&>h2]:font-semibold [&>h2]:text-ink [&>h2]:mt-10 [&>h2]:mb-3
      [&>h3]:font-heading [&>h3]:text-xl [&>h3]:font-semibold [&>h3]:text-ink [&>h3]:mt-8 [&>h3]:mb-2
      [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:space-y-1
      [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:space-y-1
      [&_a]:underline [&_a]:text-brand-blue
      [&_table]:w-full [&_table]:text-sm [&_table]:my-4 [&_th]:text-left [&_th]:py-2 [&_th]:px-2 [&_th]:border-b [&_th]:border-line [&_td]:py-2 [&_td]:px-2 [&_td]:border-b [&_td]:border-line
      [&>blockquote]:border-l-4 [&>blockquote]:border-lime [&>blockquote]:pl-4 [&>blockquote]:italic
      [&_strong]:text-ink">
      <Content />
    </div>
  </article>

  {guia.data.calculadora && (
    <section class="w-full py-14">
      <div class="text-center mb-8">
        <span class="eyebrow">Calculator</span>
        <h2 class="font-heading text-2xl md:text-3xl font-semibold text-ink mt-3">
          {tituloCalculadora}
        </h2>
      </div>
      {guia.data.calculadora === 'hipoteca' && <MortgageCalculator client:visible lang="en" />}
      {guia.data.calculadora === 'itp' && (
        <div class="max-w-4xl mx-auto"><ITPStandalone client:visible lang="en" /></div>
      )}
      {guia.data.calculadora === 'prestamo' && (
        <div class="max-w-4xl mx-auto"><PrestamoMaximoCalculator client:visible lang="en" /></div>
      )}
      {guia.data.calculadora === 'gastos' && (
        <div class="max-w-4xl mx-auto"><GastosCompraventaCalculator client:visible lang="en" /></div>
      )}
    </section>
  )}

  {guia.data.faq && (
    <FAQSection
      title="Frequently asked questions"
      items={guia.data.faq}
    />
  )}

  <footer class="w-full max-w-3xl mx-auto pb-10">
    <div class="pt-6 border-t border-line">
      <p class="text-xs text-ink-soft">
        This guide is informational and educational content, not financial or tax advice.
        See the <a href="/en/financial-disclaimer" class="underline text-brand-blue">financial disclaimer</a>.
      </p>
      <a href="/en/guides" class="inline-block mt-4 text-sm font-medium text-brand-blue">← All guides</a>
    </div>
  </footer>
</Layout>
