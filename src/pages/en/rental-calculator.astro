---
import Layout from '../../layouts/Layout.astro';
import RentalCalculatorComponent from '../../components/calculadora-alquiler/RentalCalculator.tsx';
import PageTracking from '../../components/PageTracking.tsx';
import { t } from '../../utils/i18n';
---

<Layout 
  title={t('seo.rental.title', 'en')} 
  description={t('seo.rental.description', 'en')}
  keywords={t('seo.rental.keywords', 'en')}
>
  <PageTracking client:load pagePath="/en/rental-calculator" pageTitle={t('seo.rental.title', 'en')} />
  <main class="w-full max-w-7xl mx-auto py-8">
    <div class="w-full">
      <!-- Header -->
      <div class="text-center mb-6">
        <span class="inline-flex rounded-full border border-blue-200 bg-blue-50 text-blue-700 px-4 py-1 text-xs font-semibold uppercase tracking-wider">
          {t('rental.title', 'en')}
        </span>
        <h1 class="font-heading text-4xl font-bold text-slate-900 mt-4 mb-3">
          {t('rental.hero.title', 'en')}
        </h1>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          {t('rental.hero.description', 'en')}
        </p>
      </div>

      <!-- Calculadora -->
      <RentalCalculatorComponent client:load lang="en" />
    </div>
  </main>
</Layout>
