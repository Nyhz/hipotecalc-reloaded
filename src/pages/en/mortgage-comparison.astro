---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import FAQSection from '../../components/seo/FAQSection.astro';
import PageTracking from '../../components/PageTracking.tsx';
import BankComparisonTable from '../../components/comparativa/BankComparisonTable.tsx';
import { OFERTAS_HIPOTECAS, FECHA_DATOS_ISO, fechaDatos, fechaOferta } from '../../constants/hipotecas-bancos';
import { fechaPublicacion } from '../../utils/ultima-modificacion';
import { comparisonFAQs } from '../../constants/mortgage-comparison-copy';
import { currentEuribor } from '../../constants/euribor-values';

const numBancos = new Set(OFERTAS_HIPOTECAS.map(o => o.banco)).size;
const title = `Spanish Mortgage Comparison ${new Date().getFullYear()}: ${numBancos} lenders and brands | Hipotecalc`;
const description = `Compare fixed, variable and mixed mortgages from ${numBancos} lenders and brands in Spain: TIN, APR, term, financing, bundled products and fees, from official sources.`;

const publicado = fechaPublicacion('src/pages/en/mortgage-comparison.astro');

// Las ofertas de la tabla como Dataset: datos estructurados del activo principal
const datasetSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": `Spanish bank mortgage comparison dataset (${new Date().getFullYear()})`,
  "description": `${OFERTAS_HIPOTECAS.length} mortgage offers (fixed, variable and mixed) from ${numBancos} lenders, brands and groups in Spain: TIN, APR, term, maximum financing, bundled products and fees, compiled from official websites and FIPRE sheets.`,
  "url": "https://www.hipotecalc.com/en/mortgage-comparison",
  "creator": { "@id": "https://www.hipotecalc.com/#organization" },
  "publisher": { "@id": "https://www.hipotecalc.com/#organization" },
  "isAccessibleForFree": true,
  "inLanguage": "en",
  ...(publicado ? { "datePublished": publicado.toISOString() } : {}),
  ...(fechaDatos ? { "dateModified": fechaDatos.toISOString(), "temporalCoverage": fechaDatos.toISOString().slice(0, 10) } : {}),
});
---
<Layout
  title={title}
  description={description}
  pageType="legal"
  datePublished={publicado}
  dateModified={fechaDatos}
>
  <PageTracking client:load pagePath="/en/mortgage-comparison" pageTitle={title} />
  <script type="application/ld+json" set:html={datasetSchema} />

  <Breadcrumbs items={[
    { name: 'Home', href: '/en' },
    { name: 'Mortgage Comparison', href: '/en/mortgage-comparison' }
  ]} />

  <div class="w-full py-8">
    <div class="text-center mb-8 reveal-up">
      <span class="eyebrow">Mortgage comparison · Spain {new Date().getFullYear()}</span>
      <h1 class="font-heading text-3xl md:text-4xl lg:text-[44px] font-semibold tracking-[-1px] text-ink mt-4 mb-3">
        Offers from {numBancos} lenders and brands
      </h1>
      <p class="text-ink-soft max-w-3xl mx-auto text-base md:text-lg">
        Compare offers published by Spanish banks and credit cooperatives: fixed,
        variable and mixed, with TIN, APR, terms, maximum financing, bundled products
        and fees. Click any row for the details.
      </p>
      <p class="font-data text-xs text-ink-soft mt-3">
        Reviewed: {fechaOferta(FECHA_DATOS_ISO, 'en')} · Latest monthly Euribor average {currentEuribor.value.toLocaleString('en-US')}% ({currentEuribor.labelEn})
      </p>
    </div>

    <div class="reveal-up reveal-delay-1">
      <BankComparisonTable client:load lang="en" />
    </div>

    <div class="max-w-3xl mx-auto mt-10 text-sm text-ink-soft space-y-3">
      <p>
        <strong class="text-ink">How to read the table:</strong> rate pairs show
        <em> discounted / standard</em> prices, unless different periods are specified. Check the
        introductory period and subsequent spread in the details. A single figure does not imply that both prices are available.
        APR includes the costs in the lender’s example; compare the same loan amount, term and bundled products.
        Variable and mixed mortgages show variable APR under each lender’s assumptions, which may use
        a different Euribor from the figure above. We do not recalculate published APRs.
        Sources and review frequency are detailed in our
        <a href="/en/methodology" class="underline text-brand-blue">methodology</a>. Explanatory terms are translated into English;
        lender and product names retain their official wording.
      </p>
      <p>
        All figures are indicative and change frequently. Before contracting, request
        the FIPRE and personalised ESIS (FEIN) from each institution and read our
        <a href="/en/financial-disclaimer" class="underline text-brand-blue">financial disclaimer</a>.
        You can simulate the payment for any of these offers with the
        <a href="/en/mortgage-calculator" class="underline text-brand-blue">mortgage calculator</a>.
      </p>
    </div>
  </div>

  <FAQSection
    title="Frequently asked questions"
    items={comparisonFAQs.en}
  />
</Layout>
