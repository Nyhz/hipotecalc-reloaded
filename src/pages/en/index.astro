---
import { getCollection } from 'astro:content';
import Herramientas from '../../components/home/Herramientas.astro';
import { getTools } from '../../constants/tools';
import Hero from '../../components/home/Hero.astro';
import StatsStrip from '../../components/home/StatsStrip.astro';
import Layout from '../../layouts/Layout.astro';
import EuriborChart from '../../components/home/EuriborChart';
import BrokerBand from '../../components/home/BrokerBand.astro';
import PageTracking from '../../components/PageTracking.tsx';
import { t, regionNameEn } from '../../utils/i18n';

// Highest-search-volume regions, linked from the home to feed the ITP cluster
const guiasItp = await getCollection('itpEn');
const itpDestacadas = ['madrid', 'catalonia', 'andalusia', 'valencian-community', 'balearic-islands']
  .map((slug) => guiasItp.find((g) => g.id === slug))
  .filter((g) => g !== undefined);
---
<Layout
  title={t('seo.home.title', 'en')}
  description={t('seo.home.description', 'en')}
>
  <PageTracking client:load pagePath="/en" pageTitle={t('seo.home.title', 'en')} />
  <Hero lang="en" />
  <StatsStrip lang="en" />
  <Herramientas tools={getTools('en')} lang="en" />

  <section class="w-full max-w-5xl mx-auto py-14">
    <div class="text-center mb-8">
      <span class="eyebrow">ITP by region</span>
      <h2 class="font-heading text-2xl md:text-3xl font-semibold text-ink mt-3 mb-3">
        How much ITP will you pay? Pick your region
      </h2>
      <p class="text-ink-soft max-w-3xl mx-auto">
        The ITP transfer tax is the biggest cost when buying a resale home in Spain
        and changes completely depending on where you buy: from an effective 3&nbsp;%
        to 13&nbsp;% in the top brackets. Check the 2026 rates and reliefs, verified
        against official sources.
      </p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {itpDestacadas.map((guia) => (
        <a href={`/en/itp/${guia.id}`} class="pl-card pl-card-hover p-4 flex flex-col gap-1">
          <span class="font-medium text-ink text-sm">{regionNameEn(guia.data.comunidad)}</span>
          <span class="font-data text-xs text-ink-soft">ITP: {guia.data.tipoGeneral}</span>
        </a>
      ))}
      <a href="/en/itp" class="pl-card pl-card-hover p-4 flex flex-col justify-center gap-1 border-l-4 border-lime">
        <span class="font-medium text-ink text-sm">All regions</span>
        <span class="font-data text-xs text-brand-blue">See the full table →</span>
      </a>
    </div>
  </section>

  <section class="w-full max-w-5xl mx-auto py-14">
    <div class="text-center mb-8">
      <span class="eyebrow">International buyers</span>
      <h2 class="font-heading text-2xl md:text-3xl font-semibold text-ink mt-3 mb-3">
        Buying in Spain as a foreigner?
      </h2>
      <p class="text-ink-soft max-w-3xl mx-auto">
        The rules change when you don't live here: banks lend 60-70% instead of
        80%, you need an NIE before anything else, and the taxes depend on the
        region. We've written the guides that answer exactly those questions.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <a href="/en/guides/mortgages-in-spain-for-non-residents" class="pl-card pl-card-hover p-4 flex flex-col gap-1">
        <span class="font-medium text-ink text-sm">Mortgages for non-residents</span>
        <span class="font-data text-xs text-ink-soft">60-70% LTV, documents, timeline</span>
      </a>
      <a href="/en/guides/buying-property-in-spain-taxes" class="pl-card pl-card-hover p-4 flex flex-col gap-1">
        <span class="font-medium text-ink text-sm">The taxes you'll pay</span>
        <span class="font-data text-xs text-ink-soft">ITP by region, VAT and AJD</span>
      </a>
      <a href="/en/guides/nie-number-buying-property-spain" class="pl-card pl-card-hover p-4 flex flex-col gap-1">
        <span class="font-medium text-ink text-sm">Getting your NIE</span>
        <span class="font-data text-xs text-ink-soft">the number you need first</span>
      </a>
      <a href="/en/guides" class="pl-card pl-card-hover p-4 flex flex-col justify-center gap-1 border-l-4 border-lime">
        <span class="font-medium text-ink text-sm">All guides</span>
        <span class="font-data text-xs text-brand-blue">Process, annual taxes and more →</span>
      </a>
    </div>
  </section>

  <EuriborChart client:only="react" ctaHref="/en/euribor" ctaLabel="Euribor today: analysis and your payment" />
  <BrokerBand lang="en" />

  <section class="w-full max-w-4xl mx-auto py-14">
    <span class="eyebrow">About Hipotecalc</span>
    <h2 class="font-heading text-2xl md:text-3xl font-semibold text-ink mt-3 mb-6">
      Your Trusted Mortgage Calculator for Spain
    </h2>
    <div class="text-ink-soft space-y-4 leading-relaxed md:columns-2 md:gap-10 [&>p]:break-inside-avoid">
      <p>
        <strong>Hipotecalc</strong> is your free tool for calculating mortgages in Spain.
        Our <strong>mortgage calculator</strong> lets you simulate your monthly mortgage payment,
        compare fixed vs variable mortgages, and calculate property purchase taxes by autonomous community.
      </p>
      <p>
        Calculate the <strong>ITP (Property Transfer Tax)</strong> with applicable regional discounts,
        track the historical evolution of <strong>Euribor</strong> rates,
        and analyze <strong>rental investment profitability</strong> with professional metrics like ROI, cash flow, and payback period.
      </p>
      <p>
        All our tools are <strong>100% free</strong>, require no registration,
        and are specifically designed for the Spanish real estate market with up-to-date data.
      </p>
    </div>
  </section>
</Layout>
