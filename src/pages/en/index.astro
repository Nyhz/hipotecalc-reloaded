---
import Herramientas from '../../components/home/Herramientas.astro';
import { getTools } from '../../constants/tools';
import Hero from '../../components/home/Hero.astro';
import StatsStrip from '../../components/home/StatsStrip.astro';
import Layout from '../../layouts/Layout.astro';
import EuriborChart from '../../components/home/EuriborChart';
import BrokerBand from '../../components/home/BrokerBand.astro';
import PageTracking from '../../components/PageTracking.tsx';
import { t } from '../../utils/i18n';
---
<Layout
  title={t('seo.home.title', 'en')}
  description={t('seo.home.description', 'en')}
  keywords={t('seo.home.keywords', 'en')}
>
  <PageTracking client:load pagePath="/en/" pageTitle={t('seo.home.title', 'en')} />
  <Hero lang="en" />
  <StatsStrip lang="en" />
  <Herramientas tools={getTools('en')} lang="en" />
  <EuriborChart client:only="react" />
  <BrokerBand lang="en" />

  <section class="w-full max-w-4xl mx-auto py-14">
    <span class="eyebrow">About Hipotecalc</span>
    <h2 class="font-heading text-2xl md:text-3xl font-semibold text-ink mt-3 mb-6">
      Your Trusted Mortgage Calculator for Spain
    </h2>
    <div class="text-ink-soft space-y-4 leading-relaxed md:columns-2 md:gap-10 [&>p]:break-inside-avoid">
      <p>
        <strong>Hipotecalc</strong> is your free tool for calculating mortgages in Spain.
        Our <strong>mortgage calculator</strong> lets you simulate your monthly mortgage payment,
        compare fixed vs variable mortgages, and calculate property purchase taxes by autonomous community.
      </p>
      <p>
        Calculate the <strong>ITP (Property Transfer Tax)</strong> with applicable regional discounts,
        track the historical evolution of <strong>Euribor</strong> rates,
        and analyze <strong>rental investment profitability</strong> with professional metrics like ROI, cash flow, and payback period.
      </p>
      <p>
        All our tools are <strong>100% free</strong>, require no registration,
        and are specifically designed for the Spanish real estate market with up-to-date data.
      </p>
    </div>
  </section>
</Layout>
