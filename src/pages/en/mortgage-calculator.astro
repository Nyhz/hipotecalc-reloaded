---
import Layout from '../../layouts/Layout.astro';
import MortgageCalculatorComponent from '../../components/calculadora-hipotecaria/MortgageCalculator'
import PageTracking from '../../components/PageTracking.tsx';
import { t } from '../../utils/i18n';
---

<Layout 
  title={t('seo.mortgage.title', 'en')}
  description={t('seo.mortgage.description', 'en')}
  keywords={t('seo.mortgage.keywords', 'en')}
>
  <PageTracking client:load pagePath="/en/mortgage-calculator" pageTitle={t('seo.mortgage.title', 'en')} />
  <main class="w-full max-w-7xl mx-auto py-8 ambient-section rounded-3xl">
    <div class="ambient-content text-center mb-6 reveal-up">
      <span class="inline-flex rounded-full border border-blue-200 bg-blue-50 text-blue-700 px-4 py-1 text-xs font-semibold uppercase tracking-wider">
        {t('mortgage.title', 'en')}
      </span>
      <p class="mt-3 text-slate-600 max-w-3xl mx-auto">
        {t('mortgage.description', 'en')}
      </p>
    </div>
    <div class="ambient-content reveal-up reveal-delay-1">
      <MortgageCalculatorComponent client:only="react" />
    </div>
  </main>
</Layout>
