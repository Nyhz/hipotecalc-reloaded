---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import PageTracking from '../../../components/PageTracking.tsx';
import Byline from '../../../components/seo/Byline.astro';
import { fechaPublicacion } from '../../../utils/ultima-modificacion';
import { resolverAutoria, refSchema } from '../../../data/authors';
import ITPStandalone from '../../../components/calculadora-itp/ITPStandalone';
import MortgageCalculator from '../../../components/calculadora-hipotecaria/MortgageCalculator';
import FAQSection from '../../../components/seo/FAQSection.astro';
import { regionNameEn } from '../../../utils/i18n';

export async function getStaticPaths() {
  const guias = await getCollection('itpEn');
  return guias.map((guia) => ({
    params: { slug: guia.id },
    props: { guia },
  }));
}

const todasLasGuias = (await getCollection('itpEn')).sort((a, b) =>
  a.data.comunidad.localeCompare(b.data.comunidad, 'es')
);

const { guia } = Astro.props;
const { Content } = await render(guia);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const SITE_BASE = 'https://www.hipotecalc.com';
const canonical = `${SITE_BASE}/en/itp/${guia.id}`;
// Mapa con la región resaltada (scripts/itp-map/make_region_maps.py)
const mapaRegion = `/img/itp/en/${guia.id}.png`;
const mapaBase = mapaRegion.replace(/\.png$/, '');

// Autoría: frontmatter > defaults de src/data/authors.ts — el schema debe
// reflejar exactamente lo que muestra el byline visible
const autoria = resolverAutoria('itp', guia.data);
// Fecha real de publicación: primer commit del fichero de contenido
const publicadoGit = fechaPublicacion(`src/content/en/guias/itp/${guia.id}.md`);
// nunca posterior a updatedDate (p. ej. traducciones añadidas a git después
// de la fecha declarada): datePublished ≤ dateModified siempre
const publicado = publicadoGit && publicadoGit < guia.data.updatedDate ? publicadoGit : guia.data.updatedDate;

const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": guia.data.title,
  "description": guia.data.description,
  "url": canonical,
  "datePublished": publicado.toISOString(),
  "dateModified": guia.data.updatedDate.toISOString(),
  "author": refSchema(autoria.autor, 'en'),
  ...(autoria.revisor ? { "reviewedBy": refSchema(autoria.revisor, 'en') } : {}),
  "inLanguage": "en",
  "publisher": { "@id": `${SITE_BASE}/#organization` },
  "mainEntityOfPage": canonical,
});

const nombre = guia.id === 'ceuta-melilla' ? 'Ceuta and Melilla' : regionNameEn(guia.data.comunidad);
const altMapa = `ITP comparison for a €200,000 resale main home in 2026, with ${nombre} highlighted; calculations use the example conditions stated on the map`;

const esForal = ['Navarra', 'País Vasco'].includes(guia.data.comunidad);
const tipoEnFrase = guia.data.tipoGeneral.charAt(0).toLowerCase() + guia.data.tipoGeneral.slice(1);

const impuestoObraNueva =
  guia.id === 'canarias'
    ? 'No. The first sale of a new home in the Canary Islands pays neither ITP nor VAT: it is subject to the IGIC (the Canary Islands indirect tax). The ITP only applies to resale homes.'
    : guia.id === 'ceuta-melilla'
      ? 'No. New homes in Ceuta and Melilla pay neither ITP nor VAT: they are subject to the IPSI (the local indirect tax). The ITP only applies to resale homes.'
      : `No. A new home bought from the developer is subject to 10% VAT (4% for special-regime/public-promotion VPO supplied by the developer) plus stamp duty (AJD). The ITP only applies to resale homes in ${nombre}.`;

// Filing deadline: each territory has a single deadline, the same one the
// body of each guide documents with its official source (Cantabria: the
// modelo 601 instructions of the ACAT's Oficina Virtual, which match the
// state fallback rule of art. 102 RD 828/1995).
const PLAZOS: Record<string, string> = {
  'cantabria': 'The deadline is 30 working days from the date of the document (the deed), not counting Saturdays, Sundays or public holidays',
  'andalusia': 'The deadline is two months counted from the day after the accrual date (the date of the deed or contract)',
  'navarre': 'The deadline is two months from the accrual date (the date of the deed or contract)',
  'aragon': 'The deadline is one month counted from the day after the date of the deed or contract',
  'balearic-islands': 'The deadline is one month from the date the act or contract is executed (the deed)',
  'canary-islands': 'The deadline is one month from the date of the act or contract (the deed)',
  'castilla-la-mancha': 'The deadline is one month from the accrual date (the date of the deed)',
  'catalonia': 'The deadline is one month from the date of the act or contract (the deed), counted date to date',
  'valencian-community': 'The deadline is one month from the day the act or contract takes place (the deed)',
  'extremadura': 'The deadline is one month from the date the act or contract takes place (the deed)',
  'galicia': 'The deadline is, as a general rule, one month from the date of the act or contract (the deed)',
  'asturias': 'The deadline is 30 working days from the date of the act or contract (the deed), not counting Saturdays, Sundays or public holidays',
  'castilla-y-leon': 'The deadline is 30 working days from the date of the act or contract (the deed), not counting Saturdays, Sundays or public holidays',
  'ceuta-melilla': 'The deadline is 30 working days from the date of the act or contract (the deed), not counting Saturdays, Sundays or public holidays',
  'la-rioja': 'The deadline is 30 working days from the date of the act or contract (the deed), not counting Saturdays, Sundays or public holidays',
  'madrid': 'The deadline is 30 working days from the date of the act or contract (the deed), not counting Saturdays, Sundays or public holidays',
  'murcia': 'The deadline is 30 working days from the date of the act or contract (the deed), not counting Saturdays, Sundays or public holidays',
  'basque-country': 'The deadline is 30 working days from the date of the act or contract (the deed), not counting Saturdays, Sundays or public holidays',
};
const plazoFrase = PLAZOS[guia.id]
  ? `${PLAZOS[guia.id]}; the exact form and filing details are covered in this guide.`
  : 'The usual deadline is 30 working days or one month from signing the deed; the exact form and deadline are covered in this guide.';

const faqItems = [
  {
    question: `How much ITP is paid in ${nombre} in 2026?`,
    answer: `The current general rate is ${tipoEnFrase}. There are also reduced rates and reliefs: ${guia.data.resumen}. Every relief has detailed requirements, explained in this guide with its legal citation.`,
  },
  {
    question: `Who pays the ITP and what is the deadline in ${nombre}?`,
    answer: `The buyer of the resale home always pays the ITP, through a self-assessment filed with the corresponding tax administration. ${plazoFrase}`,
  },
  {
    question: `What value is the ITP calculated on in ${nombre}?`,
    answer: esForal
      ? `${nombre === 'Basque Country' ? 'The Basque Country' : nombre} has a foral regime and applies its own valuation rules, which do not follow the state cadastral reference value system. The details are in the taxable base section of this guide.`
      : 'On the cadastral reference value or the purchase price if higher (art. 10 TRLITPAJD, since 2022). Paying a price below the reference value does not reduce the tax.',
  },
  {
    question: `Do new-build homes pay ITP in ${nombre}?`,
    answer: impuestoObraNueva,
  },
];
---
<Layout
  title={`${guia.data.title} | Hipotecalc`}
  description={guia.data.description}
  pageType="legal"
  ogImage={`${SITE_BASE}${mapaRegion}`}
  ogImageAlt={altMapa}
  ogType="article"
>
  <PageTracking client:load pagePath={`/en/itp/${guia.id}`} pageTitle={guia.data.title} />
  <script type="application/ld+json" set:html={articleSchema} />

  <Breadcrumbs items={[
    { name: 'Home', href: '/en' },
    { name: 'Guides', href: '/en/guides' },
    { name: 'ITP by region', href: '/en/itp' },
    { name: nombre, href: `/en/itp/${guia.id}` }
  ]} />

  <article class="w-full max-w-3xl mx-auto py-10">
    <header class="mb-8">
      <span class="eyebrow">ITP guide · {nombre}</span>
      <h1 class="font-heading text-3xl md:text-4xl font-semibold tracking-[-1px] text-ink mt-4 mb-3">
        {guia.data.title}
      </h1>
      <Byline autoria={autoria} lang="en" updated={guia.data.updatedDate} policyLinks />
    </header>
    <section id="calculadora-itp" class="mb-10">
      <h2 class="font-heading text-xl font-semibold text-ink mb-1">Calculate your ITP in {nombre}</h2>
      <p class="text-sm text-ink-soft mb-4">
        Enter the price and your circumstances: we tell you what you pay, with
        {nombre}'s reductions already applied.
      </p>
      <ITPStandalone client:load lang="en" initialComunidad={guia.data.comunidad} />
    </section>

    <figure class="mb-10">
      <picture>
        <source
          type="image/webp"
          srcset={`${mapaBase}-800.webp 800w, ${mapaBase}-1200.webp 1200w, ${mapaBase}-1800.webp 1800w`}
          sizes="(min-width: 768px) 720px, 100vw"
        />
        <img src={mapaRegion} alt={altMapa} width="1800" height="1238" loading="lazy" decoding="async" class="w-full h-auto rounded-lg" />
      </picture>
    </figure>

    <div class="pl-card p-5 mb-10 border-l-4 border-lime">
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-2">
        <span class="font-data text-[11px] uppercase tracking-widest text-ink-soft">General rate 2026</span>
        <span class="font-heading text-2xl font-bold text-ink">{guia.data.tipoGeneral}</span>
      </div>
      <p class="text-sm text-ink-soft leading-relaxed">
        <strong class="text-ink">Reductions and reliefs:</strong> {guia.data.resumen}.
      </p>
      <a href="#calculator" class="inline-block mt-3 text-sm font-medium text-brand-blue underline">
        Simulate the full mortgage in {nombre} ↓
      </a>
    </div>

    <div class="text-ink-soft leading-relaxed space-y-4
      [&>h2]:font-heading [&>h2]:text-2xl [&>h2]:font-semibold [&>h2]:text-ink [&>h2]:mt-10 [&>h2]:mb-3
      [&>h3]:font-heading [&>h3]:text-xl [&>h3]:font-semibold [&>h3]:text-ink [&>h3]:mt-8 [&>h3]:mb-2
      [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:space-y-1
      [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:space-y-1
      [&_a]:underline [&_a]:text-brand-blue [&_a]:break-words
      [&_table]:w-full [&_table]:text-sm [&_table]:my-4 [&_th]:text-left [&_th]:py-2 [&_th]:px-2 [&_th]:border-b [&_th]:border-line [&_td]:py-2 [&_td]:px-2 [&_td]:border-b [&_td]:border-line
      [&>blockquote]:border-l-4 [&>blockquote]:border-lime [&>blockquote]:pl-4 [&>blockquote]:italic
      [&_strong]:text-ink">
      <Content />
    </div>
  </article>

  <section id="calculator" class="w-full py-14">
    <div class="text-center mb-8">
      <span class="eyebrow">Preloaded calculator</span>
      <h2 class="font-heading text-2xl md:text-3xl font-semibold text-ink mt-3 mb-3">
        Calculate your mortgage and ITP in {nombre}
      </h2>
      <p class="text-ink-soft max-w-2xl mx-auto">
        The calculator already has the region selected: enter the property price and
        your savings, and use "Calculate ITP" to apply the reliefs for your case.
      </p>
    </div>
    <MortgageCalculator client:visible lang="en" initialComunidad={guia.data.comunidad} />
  </section>

  <FAQSection
    title={`Frequently asked questions about the ITP in ${nombre}`}
    items={faqItems}
  />

  <section class="w-full max-w-5xl mx-auto py-10">
    <h2 class="font-heading text-2xl font-semibold text-ink mb-2">
      Comparing with another region?
    </h2>
    <p class="text-ink-soft mb-6 max-w-3xl">
      The same home can pay a very different tax a few kilometres away: check the
      current ITP in every other region.
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {todasLasGuias
        .filter((otra) => otra.id !== guia.id)
        .map((otra) => (
          <a href={`/en/itp/${otra.id}`} class="pl-card pl-card-hover p-3 flex flex-col gap-0.5">
            <span class="font-medium text-ink text-sm">
              {otra.id === 'ceuta-melilla' ? 'Ceuta and Melilla' : regionNameEn(otra.data.comunidad)}
            </span>
            <span class="font-data text-xs text-ink-soft">{otra.data.tipoGeneral}</span>
          </a>
        ))}
    </div>
  </section>

  <footer class="w-full max-w-3xl mx-auto pb-10">
    <div class="pt-6 border-t border-line">
      <p class="text-xs text-ink-soft">
        This guide is informational content, not tax advice. Legislation verified on
        {formatDate(guia.data.updatedDate)} against the official sources linked; rates
        may change. See the <a href="/en/financial-disclaimer" class="underline text-brand-blue">financial disclaimer</a>.
      </p>
      <a href="/en/itp" class="inline-block mt-4 text-sm font-medium text-brand-blue">← The ITP in every region</a>
    </div>
  </footer>
</Layout>
