---
import { REVIEWED } from '../fiscal/sources';
import Layout from '../layouts/Layout.astro';
import Byline from '../components/seo/Byline.astro';
import { resolverAutoria } from '../data/authors';
import { ultimaModificacionConjunta, fechaPublicacion } from '../utils/ultima-modificacion';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import PageTracking from '../components/PageTracking.tsx';
import FAQSection from '../components/seo/FAQSection.astro';
import GastosCompraventaCalculator from '../components/gastos/GastosCompraventaCalculator';

const title = 'Calculadora de gastos de compraventa de vivienda 2026 | Hipotecalc';
const description =
  'Calcula todos los gastos de comprar una vivienda: ITP o IVA y AJD según tu comunidad, notaría, registro, gestoría y tasación, con el total y el ahorro necesario.';
const autoria = resolverAutoria('calculadora');
// La página muestra los tipos de comunidades.ts:
// su última revisión avanza también cuando se revisan esos ficheros
const actualizado = new Date(Math.max(Date.parse(REVIEWED), ultimaModificacionConjunta('src/pages/calculadora-gastos-compraventa.astro', 'src/constants/comunidades.ts')?.getTime() ?? 0));
const publicado = fechaPublicacion('src/pages/calculadora-gastos-compraventa.astro');

---
<Layout autoria={autoria} datePublished={publicado} dateModified={actualizado} title={title} description={description}>
  <PageTracking client:load pagePath="/calculadora-gastos-compraventa" pageTitle={title} />

  <Breadcrumbs items={[
    { name: 'Inicio', href: '/' },
    { name: 'Calculadora de gastos', href: '/calculadora-gastos-compraventa' }
  ]} />

  <div class="w-full max-w-4xl mx-auto py-10">
    <header class="text-center mb-10">
      <span class="eyebrow">Gastos de compraventa · España 2026</span>
      <h1 class="font-heading text-3xl md:text-4xl lg:text-[44px] font-semibold tracking-[-1px] text-ink mt-4 mb-4">
        ¿Cuánto cuesta de verdad comprar una vivienda?
      </h1>
      <div class="mt-2 mb-1"><Byline autoria={autoria} lang="es" updated={actualizado} /></div>
      <p class="text-ink-soft max-w-3xl mx-auto text-base md:text-lg">
        Al precio del piso hay que sumarle los impuestos y gastos que correspondan
        a tu operación. Elige tu comunidad y el tipo de vivienda y obtén el desglose
        completo: impuestos, notaría, registro, gestoría y tasación.
      </p>
    </header>

    <GastosCompraventaCalculator client:load lang="es" />

    <section class="mt-14 max-w-3xl mx-auto">
      <h2 class="font-heading text-2xl font-semibold text-ink mb-4">Qué incluye (y qué no)</h2>
      <div class="text-ink-soft space-y-4 leading-relaxed">
        <p>
          El desglose cubre los gastos <strong>de la compraventa</strong>: el impuesto
          (ITP en vivienda usada; IVA, IGIC o IPSI más AJD en la primera entrega de
          obra nueva), la notaría y el registro —aranceles regulados que crecen con
          el precio— y, si compras con hipoteca, la gestoría y la tasación. Desde la
          Ley 5/2019, los gastos del <em>préstamo</em> (su notaría, registro, gestoría
          y AJD) los paga el banco, así que no se suman aquí: el detalle está en la
          <a href="/guias/gastos-compraventa" class="underline text-brand-blue"> guía de gastos de compraventa</a>.
        </p>
        <p>
          Sin datos suficientes no se concede un beneficio fiscal. Abre «Fecha, base fiscal y beneficios»
          para comprobar tus requisitos personales; es el mismo motor de la
          <a href="/calculadora-itp" class="underline text-brand-blue">calculadora de ITP</a>
          o en la <a href="/itp" class="underline text-brand-blue">guía de tu comunidad</a>.
          Y si aún no sabes cuánto te prestaría el banco, empieza por
          <a href="/cuanto-me-prestan" class="underline text-brand-blue"> ¿cuánto me prestan?</a>.
        </p>
      </div>
    </section>

    <section class="mt-14 max-w-3xl mx-auto">
      <h2 class="font-heading text-2xl font-semibold text-ink mb-4">Un ejemplo con números: piso de 250.000&nbsp;€ en Madrid</h2>
      <div class="text-ink-soft space-y-4 leading-relaxed">
        <p>
          Segunda mano, comprado con hipoteca, sin aplicar beneficios personales ni de vivienda habitual. Este es el desglose que obtendrías de
          la calculadora, partida a partida:
        </p>
        <div class="pl-card p-5">
          <ul class="space-y-1.5 text-sm font-data">
            <li class="flex justify-between border-b border-ink/10 pb-1.5"><span>ITP (6&nbsp;%, Madrid)</span><span>15.000&nbsp;€</span></li>
            <li class="flex justify-between border-b border-ink/10 pb-1.5"><span>Notaría (escritura de compraventa)</span><span>≈ 825&nbsp;€</span></li>
            <li class="flex justify-between border-b border-ink/10 pb-1.5"><span>Registro de la Propiedad</span><span>≈ 355&nbsp;€</span></li>
            <li class="flex justify-between border-b border-ink/10 pb-1.5"><span>Gestoría</span><span>≈ 350&nbsp;€</span></li>
            <li class="flex justify-between border-b border-ink/10 pb-1.5"><span>Tasación (la exige el banco)</span><span>≈ 400&nbsp;€</span></li>
            <li class="flex justify-between font-semibold text-ink pt-1"><span>Total de gastos e impuestos</span><span>≈ 16.930&nbsp;€ (6,8&nbsp;%)</span></li>
          </ul>
        </div>
        <p>
          Con la entrada del 20&nbsp;% que el banco no financia (50.000&nbsp;€), el
          <strong>ahorro total necesario ronda los 66.900&nbsp;€</strong>. Y fíjate en el peso de
          cada partida: el impuesto es el 89&nbsp;% del total de gastos. Por eso la
          comunidad importa tanto — el mismo piso en Cataluña, con un tipo general
          del 10&nbsp;%, pagaría 25.000&nbsp;€ solo de ITP — y por eso, en obra nueva, la
          cuenta sube: 10&nbsp;% de IVA (25.000&nbsp;€) más el AJD autonómico
          según comunidad y beneficios acreditados. Existen exenciones, tipos inferiores al 0,5&nbsp;% y el 2&nbsp;% balear desde 1.000.000&nbsp;€. En Canarias, Ceuta y Melilla se aplica IGIC o IPSI, no IVA.
        </p>
      </div>
    </section>

    <section class="mt-14 max-w-3xl mx-auto">
      <h2 class="font-heading text-2xl font-semibold text-ink mb-4">Dónde se puede recortar (y dónde no)</h2>
      <div class="text-ink-soft space-y-4 leading-relaxed">
        <p>
          La notaría y el registro son <strong>aranceles regulados</strong>: apenas varían
          entre despachos y no se negocian. El margen real está en el impuesto:
        </p>
        <ul class="list-disc pl-6 space-y-2">
          <li>
            <strong>Tipos reducidos del ITP.</strong> La edad, familia, discapacidad y
            protección de la vivienda pueden permitir beneficios, con requisitos
            distintos en cada territorio. Comprueba tu caso en la
            <a href="/calculadora-itp" class="underline text-brand-blue">calculadora de ITP</a>.
          </li>
          <li>
            <strong>El valor de referencia.</strong> Desde 2022 el impuesto se calcula
            sobre el mayor entre el precio y el valor de referencia catastral:
            consúltalo antes de firmar, porque si supera el precio pactado, pagarás
            impuesto sobre esa cifra mayor.
          </li>
          <li>
            <strong>Los gastos del préstamo ya no son tuyos.</strong> Desde la Ley
            5/2019 el banco paga la notaría, el registro, la gestoría y el AJD de la
            hipoteca; a ti solo te corresponde la tasación. Si un presupuesto te los
            incluye, algo sobra.
          </li>
        </ul>
        <p>
          ¿Vendes para comprar? Entonces te falta una pieza: la
          <a href="/calculadora-plusvalia" class="underline text-brand-blue">plusvalía municipal</a>
          que pagarás como vendedor.
        </p>
      </div>
    </section>
  </div>

  <FAQSection
    title="Preguntas frecuentes sobre los gastos de compraventa"
    items={[
      {
        question: "¿Cuánto suman los gastos de comprar una vivienda?",
        answer: "No hay un porcentaje único: depende del ITP autonómico y tus requisitos, o de IVA/IGIC/IPSI más AJD en primera entrega. La calculadora separa impuestos, gastos estimados y entrada, sin cargar al comprador el AJD del préstamo hipotecario."
      },
      {
        question: "¿Qué gastos paga el banco y cuáles el comprador?",
        answer: "Desde la Ley 5/2019, el banco paga la notaría, el registro, la gestoría y el AJD del préstamo hipotecario; el comprador paga la tasación y todos los gastos de la compraventa: impuestos, notaría y registro de la compra."
      },
      {
        question: "¿La calculadora incluye las bonificaciones del ITP?",
        answer: "No, aplica el tipo general de cada comunidad para darte el escenario base. Si tienes derecho a tipos reducidos (jóvenes, familia numerosa, discapacidad, VPO…), usa la calculadora de ITP, que sí los aplica, y resta la diferencia."
      },
      {
        question: "¿Por qué la notaría y el registro son aproximados?",
        answer: "Son aranceles regulados que dependen del importe de la operación y de la extensión de la escritura (folios, copias). La calculadora usa una estimación realista por tramos de precio; la cifra exacta te la dará la notaría al preparar la firma."
      }
    ]}
  />
</Layout>
