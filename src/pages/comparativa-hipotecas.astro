---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import FAQSection from '../components/seo/FAQSection.astro';
import PageTracking from '../components/PageTracking.tsx';
import BankComparisonTable from '../components/comparativa/BankComparisonTable.tsx';
import { OFERTAS_HIPOTECAS, FECHA_DATOS_ISO, fechaDatos, fechaOferta } from '../constants/hipotecas-bancos';
import { fechaPublicacion } from '../utils/ultima-modificacion';
import { comparisonFAQs } from '../constants/mortgage-comparison-copy';
import { currentEuribor } from '../constants/euribor-values';

const numBancos = new Set(OFERTAS_HIPOTECAS.map(o => o.banco)).size;
const title = `Comparativa de Hipotecas ${new Date().getFullYear()}: ${numBancos} entidades y marcas | Hipotecalc`;
const description = `Compara las hipotecas fijas, variables y mixtas de ${numBancos} entidades y marcas en España: TIN, TAE, plazo, financiación, vinculaciones y comisiones, con fuentes oficiales.`;

const publicado = fechaPublicacion('src/pages/comparativa-hipotecas.astro');

// Las ofertas de la tabla como Dataset: datos estructurados del activo principal
const datasetSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": `Comparativa de hipotecas de la banca española (${new Date().getFullYear()})`,
  "description": `${OFERTAS_HIPOTECAS.length} ofertas hipotecarias (fija, variable y mixta) de ${numBancos} entidades, marcas y grupos de España: TIN, TAE, plazo, financiación máxima, vinculaciones y comisiones, recopiladas de webs oficiales y fichas FIPRE.`,
  "url": "https://www.hipotecalc.com/comparativa-hipotecas",
  "creator": { "@id": "https://www.hipotecalc.com/#organization" },
  "publisher": { "@id": "https://www.hipotecalc.com/#organization" },
  "isAccessibleForFree": true,
  "inLanguage": "es",
  ...(publicado ? { "datePublished": publicado.toISOString() } : {}),
  ...(fechaDatos ? { "dateModified": fechaDatos.toISOString(), "temporalCoverage": fechaDatos.toISOString().slice(0, 10) } : {}),
});
---
<Layout
  title={title}
  description={description}
  pageType="legal"
  datePublished={publicado}
  dateModified={fechaDatos}
>
  <PageTracking client:load pagePath="/comparativa-hipotecas" pageTitle={title} />
  <script type="application/ld+json" set:html={datasetSchema} />

  <Breadcrumbs items={[
    { name: 'Inicio', href: '/' },
    { name: 'Comparativa de Hipotecas', href: '/comparativa-hipotecas' }
  ]} />

  <div class="w-full py-8">
    <div class="text-center mb-8 reveal-up">
      <span class="eyebrow">Comparativa de hipotecas · España {new Date().getFullYear()}</span>
      <h1 class="font-heading text-3xl md:text-4xl lg:text-[44px] font-semibold tracking-[-1px] text-ink mt-4 mb-3">
        Ofertas de {numBancos} entidades y marcas
      </h1>
      <p class="text-ink-soft max-w-3xl mx-auto text-base md:text-lg">
        Compara ofertas publicadas por bancos, cajas y cooperativas españolas: fija, variable y mixta,
        con TIN, TAE, plazos, financiación máxima, vinculaciones y comisiones. Pulsa en cualquier fila para ver el detalle.
      </p>
      <p class="font-data text-xs text-ink-soft mt-3">
        Revisión: {fechaOferta(FECHA_DATOS_ISO, 'es')} · Última media mensual del euríbor {currentEuribor.value.toLocaleString('es-ES')}% ({currentEuribor.labelEs})
      </p>
    </div>

    <div class="reveal-up reveal-delay-1">
      <BankComparisonTable client:load />
    </div>

    <div class="max-w-3xl mx-auto mt-10 text-sm text-ink-soft space-y-3">
      <p>
        <strong class="text-ink">Cómo leer la tabla:</strong> las parejas de tipos se muestran como
        <em> bonificado / sin bonificar</em>, salvo indicación de periodos distintos. Comprueba el
        tramo inicial y el diferencial en el detalle. Una cifra única no implica que existan ambos precios.
        La TAE incluye los costes del ejemplo del banco; compara el mismo importe, plazo y vinculaciones.
        En variables y mixtas se trata de una TAE variable, calculada con las hipótesis de cada entidad,
        que pueden usar un euríbor distinto al mostrado arriba. No recalculamos las TAE publicadas.
        El detalle de fuentes y frecuencia de revisión está en nuestra
        <a href="/metodologia" class="underline text-brand-blue">metodología</a>.
      </p>
      <p>
        Todas las cifras son orientativas y cambian con frecuencia. Antes de contratar, solicita la
        FIPRE y la FEIN personalizada a cada entidad y consulta nuestro
        <a href="/disclaimer-financiero" class="underline text-brand-blue">disclaimer financiero</a>.
        Puedes simular la cuota de cualquiera de estas ofertas con la
        <a href="/calculadora-hipotecaria" class="underline text-brand-blue">calculadora hipotecaria</a>.
      </p>
    </div>
  </div>

  <FAQSection
    title="Preguntas frecuentes sobre la comparativa"
    items={comparisonFAQs.es}
  />
</Layout>
