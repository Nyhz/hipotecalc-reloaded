---
import { REVIEWED } from '../fiscal/sources';
import { getCollection } from 'astro:content';
import Byline from '../components/seo/Byline.astro';
import { resolverAutoria } from '../data/authors';
import { ultimaModificacionConjunta, fechaPublicacion } from '../utils/ultima-modificacion';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import PageTracking from '../components/PageTracking.tsx';
import FAQSection from '../components/seo/FAQSection.astro';
import ITPStandalone from '../components/calculadora-itp/ITPStandalone';

const guiasItp = (await getCollection('itp')).sort((a, b) =>
  a.data.comunidad.localeCompare(b.data.comunidad, 'es')
);

const title = 'Calculadora de ITP 2026: calcula el impuesto de tu vivienda | Hipotecalc';
const description =
  'Calcula el ITP de tu vivienda de segunda mano en cualquier comunidad autónoma, con las bonificaciones para jóvenes, familias numerosas o discapacidad. Gratis y al instante.';
const autoria = resolverAutoria('calculadora');
// La página muestra los tipos de comunidades.ts a través del motor de ITP:
// su última revisión avanza también cuando se revisan esos ficheros
const actualizado = new Date(Math.max(Date.parse(REVIEWED), ultimaModificacionConjunta('src/pages/calculadora-itp.astro', 'src/constants/comunidades.ts', 'src/utils/calculadora-itp.ts')?.getTime() ?? 0));
const publicado = fechaPublicacion('src/pages/calculadora-itp.astro');

---
<Layout autoria={autoria} datePublished={publicado} dateModified={actualizado} title={title} description={description}>
  <PageTracking client:load pagePath="/calculadora-itp" pageTitle={title} />

  <Breadcrumbs items={[
    { name: 'Inicio', href: '/' },
    { name: 'Calculadora de ITP', href: '/calculadora-itp' }
  ]} />

  <div class="w-full max-w-4xl mx-auto py-10">
    <header class="text-center mb-10">
      <span class="eyebrow">Calculadora de ITP · España 2026</span>
      <h1 class="font-heading text-3xl md:text-4xl lg:text-[44px] font-semibold tracking-[-1px] text-ink mt-4 mb-4">
        Calculadora del Impuesto de Transmisiones Patrimoniales
      </h1>
      <div class="mt-2 mb-1"><Byline autoria={autoria} lang="es" updated={actualizado} /></div>
      <p class="text-ink-soft max-w-3xl mx-auto text-base md:text-lg">
        Elige tu comunidad autónoma, indica el precio y tu situación (edad, familia,
        discapacidad…) y obtén al instante el ITP estimado con las bonificaciones que
        te corresponden. En una primera entrega de vivienda nueva no se paga ITP: consulta por separado IVA, IGIC o IPSI y el AJD de la adquisición.
      </p>
    </header>

    <ITPStandalone client:load />

    <section class="mt-14">
      <h2 class="font-heading text-2xl font-semibold text-ink mb-4">
        Consulta la guía de tu comunidad
      </h2>
      <p class="text-ink-soft mb-6">
        Cada comunidad aplica tipos y requisitos distintos. En nuestras guías tienes el
        detalle completo con su cita legal, verificado con fuentes oficiales:
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {guiasItp.map((guia) => (
          <a href={`/itp/${guia.id}`} class="pl-card pl-card-hover p-4 flex flex-col gap-1">
            <span class="font-medium text-ink text-sm">
              {guia.id === 'ceuta-melilla' ? 'Ceuta y Melilla' : guia.data.comunidad}
            </span>
            <span class="font-data text-xs text-ink-soft">ITP: {guia.data.tipoGeneral}</span>
          </a>
        ))}
      </div>
    </section>
  </div>

  <FAQSection
    title="Preguntas frecuentes sobre la calculadora de ITP"
    items={[
      {
        question: "¿Qué es el ITP y cuándo se paga?",
        answer: "El Impuesto de Transmisiones Patrimoniales grava la compra de vivienda de segunda mano y lo paga siempre el comprador. El plazo de autoliquidación depende de la comunidad y se cuenta desde la fecha de la escritura o del contrato: dos meses en Andalucía y Navarra, un mes en ocho comunidades (Cataluña, Comunitat Valenciana, Galicia, Extremadura, entre otras) y 30 días hábiles en la mayoría de las restantes. La primera entrega de vivienda nueva no paga ITP: el IVA ordinario es del 10 %, con el 4 % reservado a la VPO especial/pública entregada por el promotor (por IGIC en Canarias y por IPSI en Ceuta y Melilla)."
      },
      {
        question: "¿Sobre qué valor calcula el impuesto esta calculadora?",
        answer: "Precio y valores fiscales son entradas separadas. Para el ITP de régimen común se usa el mayor entre precio, valor declarado y referencia; sin referencia, también se considera el valor de mercado aportado. Las valoraciones forales se tratan aparte. IVA/IGIC/IPSI se calcula sobre el precio sin impuestos."
      },
      {
        question: "¿Incluye las bonificaciones de mi comunidad?",
        answer: "Sí. La calculadora aplica los tipos reducidos y bonificaciones autonómicas más habituales: jóvenes, familia numerosa o monoparental, discapacidad, víctimas, vivienda protegida o zonas poco pobladas, aplicando solo beneficios cuyos requisitos estén completos y respetando bases parciales, compatibilidades y fecha de devengo."
      },
      {
        question: "¿El resultado es exacto?",
        answer: "Es una estimación rigurosa con los tipos vigentes en 2026, pero depende de respuestas correctas y de las acreditaciones oficiales. Verifica tu caso en la guía de tu comunidad o con un asesor fiscal."
      }
    ]}
  />
</Layout>
