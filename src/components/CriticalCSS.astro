---
// Critical CSS component for above-the-fold content
---

<style is:inline>
/* Critical CSS for immediate rendering */
body {
  margin: 0;
  padding: 0;
  font-family: 'Roboto', 'Roboto-fallback', -apple-system, BlinkMacSystemFont, sans-serif;
  font-display: swap;
  line-height: 1.6;
}

/* Navbar critical styles */
nav {
  position: relative;
  min-height: 64px;
  width: 100%;
}

/* Hero section dimensions to prevent CLS */
.hero-container {
  min-height: 60vh;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Button sizing for touch targets */
button {
  min-height: 44px;
  min-width: 44px;
  border: none;
  cursor: pointer;
}

/* Container widths */
.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1rem;
}

/* Image loading optimization */
img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* Form elements sizing */
input, select, textarea {
  min-height: 44px;
  width: 100%;
  box-sizing: border-box;
}

/* Responsive grid system */
.grid {
  display: grid;
  gap: 1rem;
}

@media (min-width: 768px) {
  .grid-md-2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .grid-md-3 {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (min-width: 1024px) {
  .grid-lg-3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .grid-lg-4 {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* Loading states to prevent flashing */
.loading {
  opacity: 0.7;
  pointer-events: none;
}

/* Calculator specific dimensions */
.calculator-container {
  min-height: 400px;
  width: 100%;
}

/* Chart container sizing */
.chart-container {
  width: 100%;
  height: 400px;
  background-color: #f8f9fa;
}
</style>
