---
import { Icon } from 'astro-icon/components';
import { t } from '../../utils/i18n';

export interface Tool {
  icon: string;
  title: string;
  description: string;
  href?: string;
  active?: boolean;
  /** false = solo aparece en la navegación, no como tarjeta en la home */
  card?: boolean;
}
export interface Props {
  tools: Tool[];
  lang?: 'es' | 'en';
}
const { tools, lang = 'es' } = Astro.props;
---
<section class="w-full mb-16">
  <div class="py-4">
    <div class="mb-8 reveal-up">
      <h2 class="font-heading text-3xl md:text-[34px] font-semibold tracking-[-1px] text-ink">
        {lang === 'en' ? 'Financial Calculators' : 'Calculadoras Financieras'}
      </h2>
      <p class="mt-2 text-ink-soft max-w-2xl">
        {lang === 'en'
          ? 'Professional tools built to help you evaluate mortgage and rental scenarios with confidence.'
          : 'Herramientas profesionales para evaluar escenarios hipotecarios y de inversión en alquiler con claridad.'}
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {tools.filter((tool) => tool.card !== false).map((tool, index) => (
        tool.active !== false && tool.href ? (
          <a
            href={tool.href}
            class="pl-card pl-card-hover group p-7 flex flex-col items-start relative"
            aria-label={`${t('common.accessTool', lang)} ${tool.title}: ${tool.description}`}
            role="button"
            tabindex="0"
            style={`animation-delay: ${90 + index * 80}ms;`}
          >
            <div class="icon-chip mb-4" aria-hidden="true">
              <Icon name={tool.icon} size={24} class="text-ink" />
            </div>
            <span class="font-heading text-[23px] font-semibold text-ink mb-2">{tool.title}</span>
            <p class="text-sm text-ink-soft leading-relaxed mb-4">{tool.description}</p>
            <div class="mb-4 flex items-center gap-2">
              <span class="font-data text-[10px] uppercase tracking-wide border border-line rounded-full px-2.5 py-1 text-ink-soft">{lang === 'en' ? '2-3 min' : '2-3 min'}</span>
              <span class="font-data text-[10px] uppercase tracking-wide border border-line rounded-full px-2.5 py-1 text-ink-soft">{lang === 'en' ? 'Interactive' : 'Interactiva'}</span>
            </div>
            <span class="arrow-chip absolute top-6 right-6 text-ink" aria-hidden="true">→</span>
            <span class="sr-only">{t('common.linkToAccess', lang)} {tool.title}</span>
          </a>
        ) : (
          <div
            class="pl-card pl-card-hover group p-7 flex flex-col items-start relative opacity-60"
            aria-label={`${tool.title}: ${t('common.comingSoon', lang)}`}
            role="region"
            style={`animation-delay: ${90 + index * 80}ms;`}
          >
            <div class="icon-chip mb-4 bg-paper-2 text-ink-soft" aria-hidden="true">
              <Icon name={tool.icon} size={24} class="text-ink-soft" />
            </div>
            <span class="font-heading text-[23px] font-semibold text-ink mb-2">{tool.title}</span>
            <p class="text-sm text-ink-soft leading-relaxed mb-4">{tool.description}</p>
            <span class="text-ink-soft font-semibold flex items-center gap-1 cursor-not-allowed" aria-label={t('common.toolComingSoon', lang)}>
              {t('common.comingSoon', lang)}
            </span>
          </div>
        )
      ))}
    </div>
  </div>
</section>
