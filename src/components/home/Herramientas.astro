---
import { Icon } from 'astro-icon/components';
export interface Tool {
  icon: string;
  title: string;
  description: string;
  href?: string;
  active?: boolean;
}
export interface Props {
  tools: Tool[];
}
const { tools } = Astro.props;
---
<section class="w-full mb-16">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {tools.map(tool => (
        tool.active !== false && tool.href ? (
          <a 
            href={tool.href} 
            class="bg-white/80 border border-blue-100 rounded-xl p-8 flex flex-col items-start shadow-sm hover:shadow-md transition-shadow duration-300 min-h-[240px] cursor-pointer group focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            aria-label={`Acceder a ${tool.title}: ${tool.description}`}
            role="button"
            tabindex="0"
          >
            <div class="mb-4 text-blue-600 w-8 h-8 flex items-center justify-center" aria-hidden="true">
              <Icon name={tool.icon} size={32} class="text-blue-600 group-hover:scale-110 transition-transform duration-200" />
            </div>
            <span class="text-xl font-bold mb-2 text-blue-900 group-hover:text-blue-700 transition-colors duration-200">{tool.title}</span>
            <p class="text-blue-800 mb-4 flex-grow group-hover:text-blue-600 transition-colors duration-200">{tool.description}</p>
            <span class="text-blue-600 font-semibold flex items-center gap-1 transition-all duration-200" aria-hidden="true">
              Saber más <span aria-hidden="true">→</span>
            </span>
            <span class="sr-only">Enlace para acceder a {tool.title}</span>
          </a>
        ) : (
          <div 
            class="bg-white/50 border border-blue-100 rounded-xl p-8 flex flex-col items-start shadow-sm min-h-[240px] opacity-60"
            aria-label={`${tool.title}: Próximamente disponible`}
            role="region"
          >
            <div class="mb-4 text-blue-400 w-8 h-8 flex items-center justify-center" aria-hidden="true">
              <Icon name={tool.icon} size={32} class="text-blue-400" />
            </div>
            <span class="text-xl font-bold mb-2 text-blue-700">{tool.title}</span>
            <p class="text-blue-600 mb-4 flex-grow">{tool.description}</p>
            <span class="text-blue-400 font-semibold flex items-center gap-1 cursor-not-allowed" aria-label="Esta herramienta estará disponible próximamente">
              Próximamente
            </span>
          </div>
        )
      ))}
    </div>
  </div>
</section> 