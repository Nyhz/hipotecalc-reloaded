---
import { Icon } from 'astro-icon/components';
import { t } from '../../utils/i18n';

export interface Tool {
  icon: string;
  title: string;
  description: string;
  href?: string;
  active?: boolean;
}
export interface Props {
  tools: Tool[];
  lang?: 'es' | 'en';
}
const { tools, lang = 'es' } = Astro.props;
---
<section class="w-full mb-16">
  <div class="max-w-[1920px] mx-auto py-12">
    <div class="mb-8 reveal-up">
      <h2 class="font-heading text-3xl md:text-4xl font-extrabold text-slate-900">
        {lang === 'en' ? 'Financial Calculators' : 'Calculadoras Financieras'}
      </h2>
      <p class="mt-2 text-slate-600 max-w-2xl">
        {lang === 'en'
          ? 'Professional tools built to help you evaluate mortgage and rental scenarios with confidence.'
          : 'Herramientas profesionales para evaluar escenarios hipotecarios y de inversión en alquiler con claridad.'}
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {tools.map((tool, index) => (
        tool.active !== false && tool.href ? (
          <a 
            href={tool.href} 
            class="surface-card reveal-up p-8 flex flex-col items-start min-h-[250px] cursor-pointer group focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 hover:-translate-y-1 hover:shadow-xl transition-all duration-300"
            aria-label={`${t('common.accessTool', lang)} ${tool.title}: ${tool.description}`}
            role="button"
            tabindex="0"
            style={`animation-delay: ${90 + index * 80}ms;`}
          >
            <div class="mb-5 w-11 h-11 rounded-xl border border-blue-100 bg-blue-50 text-blue-700 flex items-center justify-center" aria-hidden="true">
              <Icon name={tool.icon} size={24} class="text-blue-700 group-hover:scale-110 transition-transform duration-200" />
            </div>
            <span class="font-heading text-2xl font-extrabold mb-2 text-slate-900 group-hover:text-blue-800 transition-colors duration-200">{tool.title}</span>
            <p class="text-slate-600 mb-5 flex-grow group-hover:text-slate-700 transition-colors duration-200">{tool.description}</p>
            <div class="mb-4 flex items-center gap-2 text-xs text-slate-500">
              <span class="rounded-full border border-slate-200 px-2 py-1">{lang === 'en' ? '2-3 min' : '2-3 min'}</span>
              <span class="rounded-full border border-slate-200 px-2 py-1">{lang === 'en' ? 'Interactive' : 'Interactiva'}</span>
            </div>
            <span class="text-blue-700 font-semibold flex items-center gap-1 transition-all duration-200" aria-hidden="true">
              {t('common.learnMore', lang)} <span aria-hidden="true">→</span>
            </span>
            <span class="sr-only">{t('common.linkToAccess', lang)} {tool.title}</span>
          </a>
        ) : (
          <div 
            class="surface-card reveal-up p-8 flex flex-col items-start min-h-[250px] opacity-60"
            aria-label={`${tool.title}: ${t('common.comingSoon', lang)}`}
            role="region"
            style={`animation-delay: ${90 + index * 80}ms;`}
          >
            <div class="mb-5 w-11 h-11 rounded-xl border border-slate-200 bg-slate-100 text-slate-500 flex items-center justify-center" aria-hidden="true">
              <Icon name={tool.icon} size={24} class="text-slate-500" />
            </div>
            <span class="font-heading text-2xl font-extrabold mb-2 text-slate-600">{tool.title}</span>
            <p class="text-slate-500 mb-4 flex-grow">{tool.description}</p>
            <span class="text-slate-500 font-semibold flex items-center gap-1 cursor-not-allowed" aria-label={t('common.toolComingSoon', lang)}>
              {t('common.comingSoon', lang)}
            </span>
          </div>
        )
      ))}
    </div>
  </div>
</section> 
