---
import { t } from '../../utils/i18n';

export interface Post {
  title: string;
  excerpt: string;
  href: string;
}
export interface Props {
  posts: Post[];
  title?: string;
  description?: string;
  lang?: 'es' | 'en';
}
const { posts, title, description, lang = 'es' } = Astro.props;
const defaultTitle = title || t('home.posts.title', lang);
const defaultDescription = description || t('home.posts.description', lang);
---
<section class="w-full max-w-6xl mx-auto py-16">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-8 px-4">
    <div>
      <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-2">{defaultTitle}</h2>
      <p class="text-blue-800 max-w-2xl">{defaultDescription}</p>
    </div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 px-4">
    {posts.map(post => (
      <article class="border border-blue-100/30 rounded-xl p-6 shadow-sm flex flex-col h-full">
        <h3 class="text-xl font-semibold mb-2 text-blue-900">{post.title}</h3>
        <p class="text-blue-800 mb-4">{post.excerpt}</p>
        <a href={post.href} class="mt-auto text-blue-600 font-semibold hover:underline flex items-center gap-1 cursor-pointer" aria-label={`${t('common.readMoreAbout', lang)} ${post.title}`}>{t('common.readMore', lang)} <span aria-hidden="true">→</span></a>
      </article>
    ))}
  </div>
</section>
