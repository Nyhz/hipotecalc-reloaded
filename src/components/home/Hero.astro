---
export interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = '/assets/background.svg' } = Astro.props;
---
<section class="relative w-full bg-blue-50 flex flex-col items-center justify-center min-h-[340px] md:min-h-[420px] overflow-hidden">
  <div class="relative z-10 flex flex-col items-center justify-center py-16 px-4">
    <h1 class="text-4xl md:text-5xl font-bold mb-4 text-center text-blue-900 drop-shadow">{title}</h1>
    <p class="text-lg md:text-xl text-blue-800 max-w-2xl mx-auto text-center">{description}</p>
  </div>
</section> 