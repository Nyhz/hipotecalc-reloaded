---
export interface Props {
  title: string;
  description: string;
  lang?: 'es' | 'en';
}
const { title, description, lang = 'es' } = Astro.props;
import { t } from '../../utils/i18n';
---
<section class="relative w-full flex items-center justify-center min-h-[560px] md:min-h-[680px] overflow-hidden mt-6">
  <!-- Background decorative elements -->
  <div class="absolute inset-0 overflow-hidden">
    <!-- Large circle top left -->
    <div class="absolute -top-40 -left-40 w-80 h-80 bg-blue-200/30 rounded-full blur-3xl"></div>
    <!-- Medium circle top right -->
    <div class="absolute -top-20 -right-20 w-60 h-60 bg-indigo-200/30 rounded-full blur-2xl"></div>
    <!-- Geometric shapes -->
    <div class="absolute top-20 right-20 w-32 h-32 border border-blue-300/30 rotate-45 hidden md:block"></div>
    <div class="absolute bottom-40 left-10 w-24 h-24 border border-indigo-300/30 rotate-12 hidden lg:block"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(37,99,235,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(37,99,235,0.06)_1px,transparent_1px)] bg-[size:42px_42px] opacity-30"></div>
  </div>

  <!-- Main content with explicit dimensions and font-display optimization -->
  <div class="relative z-10 w-full max-w-7xl mx-auto py-16 min-h-[400px] md:min-h-[500px]">
    <div class="grid lg:grid-cols-2 gap-12 items-center h-full">
      <!-- Left side - Text content with font stability -->
      <div class="text-center lg:text-left min-h-[420px] flex flex-col justify-center text-stable font-loading-stable">
        <span class="inline-flex mx-auto lg:mx-0 mb-4 rounded-full border border-blue-200 bg-blue-50 text-blue-700 px-4 py-1 text-xs font-semibold uppercase tracking-wider reveal-up">
          {lang === 'en' ? 'Spanish Real Estate Finance' : 'Finanzas Inmobiliarias en España'}
        </span>
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 text-slate-900 leading-tight font-display-swap reveal-up reveal-delay-1">
          <span class="min-h-[3rem] md:min-h-[4rem] lg:min-h-[5rem] flex items-center justify-center lg:justify-start">{title}</span>
        </h1>
        
        <p class="text-lg md:text-xl text-slate-600 max-w-xl mx-auto lg:mx-0 mb-8 leading-relaxed min-h-[4rem] flex items-center justify-center lg:justify-start font-display-swap reveal-up reveal-delay-2">
          {description}
        </p>
        
        <!-- CTA Buttons with fixed dimensions -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-8 min-h-[6rem] reveal-up reveal-delay-2">
          <a href={lang === 'en' ? '/en/mortgage-calculator' : '/calculadora-hipotecaria'} 
             class="btn btn-primary px-8 py-4 min-w-[220px] text-center will-change-auto h-[56px] font-display-swap">
            {t('home.hero.calculateMortgage', lang)}
          </a>
          <a href={lang === 'en' ? '/en/rental-calculator' : '/calculadora-alquiler'} 
             class="btn btn-secondary px-8 py-4 min-w-[220px] text-center will-change-auto h-[56px] font-display-swap">
            {t('home.hero.calculateRental', lang)}
          </a>
        </div>
        
        <!-- Trust indicators with fixed layout -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 text-blue-600 min-h-[60px] reveal-up reveal-delay-3">
          <div class="flex items-center gap-2 min-w-[120px] h-[40px] rounded-full border border-slate-200 bg-white/80 px-3">
            <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm whitespace-nowrap font-medium text-slate-700 font-display-swap">{t('common.free', lang)}</span>
          </div>
          <div class="flex items-center gap-2 min-w-[120px] h-[40px] rounded-full border border-slate-200 bg-white/80 px-3">
            <svg class="w-5 h-5 text-blue-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm whitespace-nowrap font-medium text-slate-700 font-display-swap">{t('common.secure', lang)}</span>
          </div>
          <div class="flex items-center gap-2 min-w-[120px] h-[40px] rounded-full border border-slate-200 bg-white/80 px-3">
            <svg class="w-5 h-5 text-blue-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm whitespace-nowrap font-medium text-slate-700 font-display-swap">{t('common.accurate', lang)}</span>
          </div>
        </div>
      </div>
      
      <!-- Right side - Visual element with fixed dimensions to prevent CLS -->
      <div class="hidden lg:flex justify-end items-center min-h-[400px]">
        <!-- Container with reserved space for rotated elements -->
        <div class="relative w-[320px] h-[400px] flex items-center justify-center">
          <!-- Main card mockup with contained transforms -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="bg-white/95 backdrop-blur-sm rounded-2xl p-8 shadow-2xl border border-blue-100 w-[280px] h-[300px] transform rotate-3 hover:rotate-0 transition-transform duration-500 will-change-transform origin-center">
              <div class="space-y-4 h-full flex flex-col justify-between">
                <div class="flex items-center justify-between min-h-[40px]">
                  <span class="text-xl font-heading font-bold text-slate-800 font-display-swap">{t('home.hero.calculatorTitle', lang)}</span>
                  <div class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                </div>
                
                <div class="space-y-3 flex-1 flex flex-col justify-center">
                  <div class="flex justify-between items-center min-h-[24px]">
                    <span class="text-slate-500 font-display-swap">{t('home.hero.propertyPrice', lang)}</span>
                    <span class="font-semibold text-slate-800 font-display-swap">300.000€</span>
                  </div>
                  <div class="flex justify-between items-center min-h-[24px]">
                    <span class="text-slate-500 font-display-swap">{t('home.hero.downPayment', lang)}</span>
                    <span class="font-semibold text-slate-800 font-display-swap">60.000€</span>
                  </div>
                  <div class="flex justify-between items-center min-h-[24px]">
                    <span class="text-slate-500 font-display-swap">{t('home.hero.term', lang)}</span>
                    <span class="font-semibold text-slate-800 font-display-swap">25 años</span>
                  </div>
                  <hr class="border-gray-200">
                  <div class="flex justify-between items-center min-h-[32px]">
                    <span class="text-slate-500 font-display-swap">{t('home.hero.monthlyPayment', lang)}</span>
                    <span class="font-bold text-2xl text-blue-600 font-display-swap">1.247€</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Secondary floating card with absolute positioning within container -->
          <div class="absolute bottom-0 right-4 bg-slate-900 rounded-xl p-4 shadow-lg transform -rotate-6 will-change-transform w-[80px] h-[80px] flex items-center justify-center float-soft">
            <div class="text-center">
              <div class="text-lg font-bold text-white leading-tight font-display-swap">{t('home.hero.interestRate', lang)}</div>
              <div class="text-xs text-white/90 leading-tight font-display-swap">{t('home.hero.euriborPlus', lang)}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section> 
