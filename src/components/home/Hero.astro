---
export interface Props {
  title: string;
  description: string;
}
const { title, description} = Astro.props;
---
<section class="relative w-full flex items-center justify-center min-h-[500px] md:min-h-[600px] overflow-hidden">
  <!-- Background decorative elements -->
  <div class="absolute inset-0 overflow-hidden">
    <!-- Large circle top left -->
    <div class="absolute -top-40 -left-40 w-80 h-80 bg-blue-100/30 rounded-full blur-3xl"></div>
    <!-- Medium circle top right -->
    <div class="absolute -top-20 -right-20 w-60 h-60 bg-blue-200/20 rounded-full blur-2xl"></div>
    <!-- Geometric shapes -->
    <div class="absolute top-20 right-20 w-32 h-32 border border-blue-200/30 rotatenpm-45 hidden md:block"></div>
    <div class="absolute bottom-40 left-10 w-24 h-24 border border-blue-300/30 rotate-12 hidden lg:block"></div>
  </div>

  <!-- Main content -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 py-16">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left side - Text content -->
      <div class="text-center lg:text-left">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-blue-900 leading-tight">
          <span class="block">{title.split(' ').slice(0, 2).join(' ')}</span>
          <span class="text-blue-600 block">{title.split(' ').slice(2).join(' ')}</span>
        </h1>
        
        <p class="text-lg md:text-xl text-blue-700 max-w-lg mx-auto lg:mx-0 mb-8 leading-relaxed">
          {description}
        </p>
        
        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a href="/calculadora-hipotecaria" 
             class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded-full transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl">
            Calcular Hipoteca
          </a>
          <a href="/calculadora-alquiler" 
             class="border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white font-semibold px-8 py-4 rounded-full transition-all duration-300 transform hover:scale-105">
            Calcular Alquiler
          </a>
        </div>
        
        <!-- Trust indicators -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-6 text-blue-600">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm">100% Gratuita</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm">Datos Seguros</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm">Cálculos Precisos</span>
          </div>
        </div>
      </div>
      
      <!-- Right side - Visual element -->
      <div class="hidden lg:flex justify-end items-center">
        <div class="relative">
          <!-- Main card mockup -->
          <div class="bg-white/95 backdrop-blur-sm rounded-2xl p-8 shadow-2xl transform rotate-3 hover:rotate-0 transition-transform duration-500">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-bold text-gray-800">Calculadora Hipoteca</h3>
                <div class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
              </div>
              
              <div class="space-y-3">
                <div class="flex justify-between">
                  <span class="text-gray-600">Precio vivienda:</span>
                  <span class="font-semibold text-gray-800">300.000€</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Entrada:</span>
                  <span class="font-semibold text-gray-800">60.000€</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Plazo:</span>
                  <span class="font-semibold text-gray-800">25 años</span>
                </div>
                <hr class="border-gray-200">
                <div class="flex justify-between">
                  <span class="text-gray-600">Cuota mensual:</span>
                  <span class="font-bold text-2xl text-blue-600">1.247€</span>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Secondary floating card -->
          <div class="absolute -bottom-4 -right-4 bg-blue-600 rounded-xl p-4 shadow-lg transform -rotate-6">
            <div class="text-center">
              <div class="text-2xl font-bold text-white">3.8%</div>
              <div class="text-sm text-blue-100">Euribor + 1%</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section> 