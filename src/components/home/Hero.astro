---
export interface Props {
  title: string;
  description: string;
}
const { title, description} = Astro.props;
---
<section class="relative w-full flex items-center justify-center min-h-[500px] md:min-h-[600px] overflow-hidden">
  <!-- Background decorative elements -->
  <div class="absolute inset-0 overflow-hidden">
    <!-- Large circle top left -->
    <div class="absolute -top-40 -left-40 w-80 h-80 bg-blue-100/30 rounded-full blur-3xl"></div>
    <!-- Medium circle top right -->
    <div class="absolute -top-20 -right-20 w-60 h-60 bg-blue-200/20 rounded-full blur-2xl"></div>
    <!-- Geometric shapes -->
    <div class="absolute top-20 right-20 w-32 h-32 border border-blue-200/30 rotate-45 hidden md:block"></div>
    <div class="absolute bottom-40 left-10 w-24 h-24 border border-blue-300/30 rotate-12 hidden lg:block"></div>
  </div>

  <!-- Main content with explicit dimensions and font-display optimization -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 py-16 min-h-[400px] md:min-h-[500px]">
    <div class="grid lg:grid-cols-2 gap-12 items-center h-full">
      <!-- Left side - Text content with font stability -->
      <div class="text-center lg:text-left min-h-[420px] flex flex-col justify-center text-stable font-loading-stable">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-blue-900 leading-tight font-display-swap">
          <span class="min-h-[3rem] md:min-h-[4rem] lg:min-h-[5rem] flex items-center justify-center lg:justify-start">{title}</span>
        </h1>
        
        <p class="text-lg md:text-xl text-blue-700 max-w-lg mx-auto lg:mx-0 mb-8 leading-relaxed min-h-[4rem] flex items-center justify-center lg:justify-start font-display-swap">
          {description}
        </p>
        
        <!-- CTA Buttons with fixed dimensions -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-8 min-h-[6rem]">
          <a href="/calculadora-hipotecaria" 
             class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded-full transition-colors duration-300 shadow-lg hover:shadow-xl min-w-[200px] text-center will-change-auto h-[56px] flex items-center justify-center font-display-swap">
            Calcular Hipoteca
          </a>
          <a href="/calculadora-alquiler" 
             class="border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white font-semibold px-8 py-4 rounded-full transition-colors duration-300 min-w-[200px] text-center will-change-auto h-[56px] flex items-center justify-center font-display-swap">
            Calcular Alquiler
          </a>
        </div>
        
        <!-- Trust indicators with fixed layout -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-6 text-blue-600 min-h-[60px]">
          <div class="flex items-center gap-2 min-w-[120px] h-[40px]">
            <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm whitespace-nowrap font-display-swap">100% Gratuita</span>
          </div>
          <div class="flex items-center gap-2 min-w-[120px] h-[40px]">
            <svg class="w-5 h-5 text-blue-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm whitespace-nowrap font-display-swap">Datos Seguros</span>
          </div>
          <div class="flex items-center gap-2 min-w-[120px] h-[40px]">
            <svg class="w-5 h-5 text-blue-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm whitespace-nowrap font-display-swap">Cálculos Precisos</span>
          </div>
        </div>
      </div>
      
      <!-- Right side - Visual element with fixed dimensions to prevent CLS -->
      <div class="hidden lg:flex justify-end items-center min-h-[400px]">
        <!-- Container with reserved space for rotated elements -->
        <div class="relative w-[320px] h-[400px] flex items-center justify-center">
          <!-- Main card mockup with contained transforms -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="bg-white/95 backdrop-blur-sm rounded-2xl p-8 shadow-2xl w-[280px] h-[300px] transform rotate-3 hover:rotate-0 transition-transform duration-500 will-change-transform origin-center">
              <div class="space-y-4 h-full flex flex-col justify-between">
                <div class="flex items-center justify-between min-h-[40px]">
                  <span class="text-xl font-bold text-gray-800 font-display-swap">Calculadora Hipoteca</span>
                  <div class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                </div>
                
                <div class="space-y-3 flex-1 flex flex-col justify-center">
                  <div class="flex justify-between items-center min-h-[24px]">
                    <span class="text-gray-600 font-display-swap">Precio vivienda:</span>
                    <span class="font-semibold text-gray-800 font-display-swap">300.000€</span>
                  </div>
                  <div class="flex justify-between items-center min-h-[24px]">
                    <span class="text-gray-600 font-display-swap">Entrada:</span>
                    <span class="font-semibold text-gray-800 font-display-swap">60.000€</span>
                  </div>
                  <div class="flex justify-between items-center min-h-[24px]">
                    <span class="text-gray-600 font-display-swap">Plazo:</span>
                    <span class="font-semibold text-gray-800 font-display-swap">25 años</span>
                  </div>
                  <hr class="border-gray-200">
                  <div class="flex justify-between items-center min-h-[32px]">
                    <span class="text-gray-600 font-display-swap">Cuota mensual:</span>
                    <span class="font-bold text-2xl text-blue-600 font-display-swap">1.247€</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Secondary floating card with absolute positioning within container -->
          <div class="absolute bottom-0 right-4 bg-blue-600 rounded-xl p-4 shadow-lg transform -rotate-6 will-change-transform w-[80px] h-[80px] flex items-center justify-center">
            <div class="text-center">
              <div class="text-lg font-bold text-white leading-tight font-display-swap">3.8%</div>
              <div class="text-xs text-white/90 leading-tight font-display-swap">Euribor + 1%</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section> 