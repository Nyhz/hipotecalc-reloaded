---
import { tools } from '../constants/tools';
---
<nav class="w-full bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 flex items-center justify-between h-16">
    <a href="/" class="text-2xl font-bold text-blue-900 tracking-tight">Hipotecalc</a>
    <ul class="flex gap-6 items-center">
      {tools.map(tool => (
        <li><a href={tool.href} class="text-blue-900 font-medium hover:text-blue-600 transition">{tool.label}</a></li>
      ))}
    </ul>
  </div>
</nav> 