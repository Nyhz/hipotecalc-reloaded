---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import Byline from '../seo/Byline.astro';
import Explorer from './Explorer';
import QuarterlyRanking from './QuarterlyRanking';
import CopyCitation from './CopyCitation';
import Methodology from './Methodology.astro';
import { resolverAutoria } from '../../data/authors';
import { data, title as indexTitle, dateLabel, quarterLabel, format, percent, summary, reportSource, reportQuarters, latestQuarter, completeQuarters, datasetSchema, downloadPath, asset, previousQuarter } from '../../analytics/model';
import { SITE, base, hub, methodPath, pilotCities, reportPath, reportsPath, cityPath } from '../../analytics/routes';
import type { AnalyticsPage } from '../../analytics/pages';
import '../../styles/analytics.css';
interface Props { page: AnalyticsPage }
const { page } = Astro.props;
const {lang,kind,path} = page, en=lang==='en', quarter=page.quarter??latestQuarter;
const source=kind==='report'?reportSource(quarter):data;
const stats=summary(quarter,source), city=source.cities.find(c=>c.code===page.cityCode);
const row=city?stats.rows.find(r=>r.code===city.code)!:null;
const fullName=indexTitle(lang), period=quarterLabel(quarter,lang);
const heading=kind==='hub'?'Hipotecalc Analytics':kind==='methodology'?(en?'How we calculate the IHEC':'Cómo calculamos el IHEC'):kind==='archive'?(en?'Quarterly IHEC reports':'Informes trimestrales del IHEC'):kind==='report'?(en?`Home purchase effort in Spain · ${period}`:`Esfuerzo de compra de vivienda · ${period}`):city?(en?`Buying a home in ${city.name}: price versus income`:`Esfuerzo de compra de vivienda en ${city.name}`):fullName;
const title=`${heading}${kind==='hub'?' · Datos del mercado de vivienda':''} | Hipotecalc`.replace(' · Datos del mercado de vivienda',en?' · Spanish housing market data':' · Datos del mercado de vivienda');
const description=city?(en?`The estimated home purchase effort in ${city.name} is ${format(row!.index,lang)} times annual household income in ${period}. Historical series, methodology and sources.`:`El esfuerzo de compra estimado en ${city.name} equivale a ${format(row!.index,lang)} rentas anuales en ${period}. Evolución, metodología y fuentes.`):kind==='report'?(en?`${period}: the median estimated home purchase effort across 100 Spanish municipalities is ${format(stats.median,lang)} annual household incomes. Read the ranking and download the results.`:`${period}: la mediana del esfuerzo de compra estimado en 100 municipios es ${format(stats.median,lang)} rentas anuales del hogar. Ranking, evolución y datos descargables.`):(en?'Explore asking prices versus estimated household income in 100 Spanish municipalities. Quarterly IHEC rankings, historical reports and transparent methodology.':'Explora el precio de la vivienda frente a la renta estimada en 100 municipios. Ranking IHEC, informes trimestrales y metodología transparente.');
const autoria=resolverAutoria('legal');
const image=asset(quarter,lang,source);
const imageAlt=en?`Estimated IHEC: six highest-effort municipalities in ${period}; 80 m² asking price divided by estimated annual household income.`:`IHEC estimado: seis municipios con mayor esfuerzo en ${period}; precio ofertado de 80 m² dividido entre renta anual estimada del hogar.`;
const schema=kind==='hub'?{'@context':'https://schema.org','@type':'DataCatalog','@id':SITE+hub(lang)+'#catalog',name:'Hipotecalc Analytics',url:SITE+hub(lang),description,creator:{'@id':SITE+'/#organization'},dataset:[{'@id':SITE+base(lang)+'#dataset'}]}:kind==='indicator'||kind==='report'?datasetSchema(lang,source,kind==='report'?quarter:undefined):null;
const article=kind==='report'||kind==='city'?{'@context':'https://schema.org','@type':'Article','@id':SITE+path+'#article',headline:heading,description,inLanguage:lang,datePublished:source.publishedAt,dateModified:source.modifiedAt,author:{'@id':SITE+'/#organization'},publisher:{'@id':SITE+'/#organization'},mainEntityOfPage:SITE+path,image:SITE+image,about:{'@id':SITE+base(lang)+'#dataset'}}:null;
const citation=en?`Hipotecalc Analytics. ${fullName} (IHEC), ${period}. ${city?city.name+'. ':''}Edition ${source.version}. Calculations by Hipotecalc using Idealista asking prices and INE income/household data. Municipal quarterly income is estimated. ${SITE+path}`:`Hipotecalc Analytics. ${fullName} (IHEC), ${period}. ${city?city.name+'. ':''}Edición ${source.version}. Elaboración de Hipotecalc con precios ofertados de Idealista y datos de renta y hogares del INE. Renta municipal trimestral estimada. ${SITE+path}`;
const qs=completeQuarters(source).filter(q=>q<=quarter);
const explorerCities=source.cities.map(c=>({...c,sourcePrice:'',observations:c.observations.filter(o=>qs.includes(o.quarter)).map(o=>({...o,monthlyPrices:[]}))}));
const archive=[...reportQuarters].reverse();
const first=quarter===reportQuarters[0];
const nearbyReports=reportQuarters.filter(q=>Math.abs(reportQuarters.indexOf(q)-reportQuarters.indexOf(quarter))===1).map(q=>({href:reportPath(q,lang),label:q<quarter?`← ${quarterLabel(q,lang)}`:`${quarterLabel(q,lang)} →`}));
---
<Layout title={title} description={description} pageType="legal" datePublished={new Date(source.publishedAt)} dateModified={new Date(source.modifiedAt)} ogImage={SITE+image} ogImageAlt={imageAlt} ogType={article?'article':'website'}>
  {schema&&<script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>}
  {article&&<script is:inline type="application/ld+json" set:html={JSON.stringify(article).replace(/</g,'\\u003c')}/>}
  <Breadcrumbs items={[{name:en?'Home':'Inicio',href:en?'/en':'/'},...(kind==='hub'?[]:[{name:'Analytics',href:hub(lang)}]),...(kind==='hub'||kind==='indicator'?[]:[{name:'IHEC',href:base(lang)}]),{name:kind==='hub'?'Analytics':kind==='indicator'?'IHEC':kind==='report'?period:kind==='city'?city!.name:kind==='archive'?(en?'Reports':'Informes'):(en?'Methodology':'Metodología'),href:path}]} />
  <div class="an">
    <header class="an-header">
      <p class="an-kicker">{kind==='hub'?(en?'HOUSING DATA & RESEARCH':'DATOS Y ANÁLISIS DE VIVIENDA'):'HIPOTECALC ANALYTICS / IHEC'}</p>
      <h1>{heading}</h1>
      <p class="an-subtitle">{kind==='hub'?(en?'Understand the housing market through transparent data, historical comparisons and research you can cite.':'Entender la vivienda con datos transparentes, comparaciones históricas y análisis que puedes citar.'):en?'How many estimated annual household incomes an 80 m² home costs at asking prices. A comparable measure across 100 Spanish municipalities.':'A cuántas rentas anuales estimadas del hogar equivale el precio ofertado de una vivienda de 80 m². Una medida comparable entre 100 municipios.'}</p>
      <Byline autoria={autoria} lang={lang} published={new Date(source.publishedAt)} />
      <p class="an-small">{en?'Source cutoff':'Corte de datos'}: {dateLabel(source.sourceCutoff,lang)} · {en?'Edition':'Edición'} {source.version} · {en?'Methodology':'Metodología'} {source.methodologyVersion}</p>
      {(kind==='indicator'||kind==='city'||kind==='report')&&<div class="an-actions"><a class="an-button secondary" href="#citar">{en?'Cite & download data':'Citar y descargar datos'} ↓</a>{kind==='indicator'&&<a class="an-button secondary" href="#ranking">{en?'View the ranking':'Ver el ranking'} ↓</a>}</div>}
    </header>
    <nav class="an-sectionnav" aria-label={en?'Analytics navigation':'Navegación de Analytics'}>
      {[{href:hub(lang),label:'Analytics'},{href:base(lang),label:en?'Index & ranking':'Índice y ranking'},{href:reportsPath(lang),label:en?'Historical reports':'Informes históricos'},{href:methodPath(lang),label:en?'Methodology':'Metodología'}].map(link=><a href={link.href} aria-current={path===link.href?'page':undefined}>{link.label}</a>)}
    </nav>

    {kind==='hub'&&<>
      <section class="an-hero an-hero-split">
        <div><p class="an-kicker">{en?'OUR FIRST INDICATOR':'NUESTRO PRIMER INDICADOR'} · {quarterLabel(latestQuarter,lang)}</p><h2>{fullName}</h2><p class="an-subtitle">{en?'Asking prices meet estimated household income. Follow the gap across 100 municipalities, quarter by quarter.':'El precio ofertado, frente a la renta estimada del hogar. Sigue esa relación en 100 municipios, trimestre a trimestre.'}</p><a class="an-button" href={base(lang)}>{en?'Explore the index':'Explorar el índice'} →</a></div>
        <div><p class="an-bignum">{format(stats.median,lang)}×</p><p>{en?'Median estimated home purchase effort':'Mediana del esfuerzo de compra estimado'}</p><p class="an-small" style="color:#b8c8da">{en?'100 municipalities · not a national average':'100 municipios · no es una media nacional'}</p></div>
      </section>
      <div class="an-grid"><div class="an-card"><p class="an-kicker">{en?'COVERAGE':'COBERTURA'}</p><span class="an-value">100</span><h3>{en?'Municipalities, one methodology':'Municipios, una metodología'}</h3><p>{en?'The same 2025 population-based sample throughout the historical series.':'La misma muestra por población de 2025 durante toda la serie histórica.'}</p></div><div class="an-card"><p class="an-kicker">{en?'HISTORICAL SERIES':'SERIE HISTÓRICA'}</p><span class="an-value">{reportQuarters.length}</span><h3>{en?'Complete quarterly reports':'Informes trimestrales completos'}</h3><p>{en?'Retrospective editions from Q1 2023, with versioned results.':'Ediciones retrospectivas desde 2023T1, con resultados versionados.'}</p></div><div class="an-card"><p class="an-kicker">{en?'TRANSPARENCY':'TRANSPARENCIA'}</p><h3>{en?'Reproducible, with limitations in view':'Reproducible, con los límites a la vista'}</h3><p>{en?'Understand the income model, source dates and what this index cannot tell you.':'Conoce el modelo de renta, las fechas de las fuentes y lo que el índice no permite concluir.'}</p><a class="an-link" href={methodPath(lang)}>{en?'Read the methodology':'Leer la metodología'} →</a></div></div>
    </>}

    {(kind==='indicator'||kind==='city'||kind==='report')&&<>
      <aside class="an-notice">{en?'Estimated indicator, not an official INE municipal quarterly statistic. It does not measure mortgage payments or actual years of saving.':'Indicador estimado, no estadística municipal trimestral oficial del INE. No mide la cuota hipotecaria ni años reales de ahorro.'} <a href={methodPath(lang)}>{en?'How it is calculated':'Cómo se calcula'} →</a></aside>
      {kind==='report'&&<p class="an-notice">{en?`Retrospective report for ${period}, published on ${dateLabel(source.publishedAt,lang)} using data available at the ${dateLabel(source.sourceCutoff,lang)} cutoff. It was not published in the quarter analysed.`:`Informe retrospectivo de ${period}, publicado el ${dateLabel(source.publishedAt,lang)} con información del corte de ${dateLabel(source.sourceCutoff,lang)}. No fue publicado en el trimestre analizado.`}</p>}
      <dl class="an-stats">
        <div class="an-stat"><dt>{city?(en?'Estimated effort':'Esfuerzo estimado'):(en?'Sample median':'Mediana de la muestra')}</dt><dd>{format(row?.index??stats.median,lang)}×</dd><small>{en?'Annual household incomes':'Rentas anuales del hogar'} · {period}</small></div>
        <div class="an-stat"><dt>{en?'Quarterly change':'Variación trimestral'}</dt><dd class={(row?.qoq??stats.qoq??0)>0?'an-up':'an-down'}>{percent(city?row!.qoq:stats.qoq,lang)}</dd><small>{first?(en?'No earlier quarter in this series':'Sin trimestre previo en esta serie'):quarterLabel(previousQuarter(quarter),lang)}</small></div>
        <div class="an-stat"><dt>{en?'Annual change':'Variación interanual'}</dt><dd>{percent(city?row!.yoy:stats.yoy,lang)}</dd><small>{en?'Same quarter, previous year':'Mismo trimestre del año anterior'}</small></div>
        <div class="an-stat"><dt>{city?(en?'Rank in the sample':'Puesto en la muestra'):(en?'Municipalities':'Municipios')}</dt><dd>{city?`${row!.rank} / 100`:'100'}</dd><small>{city?(en?'1 = highest effort':'1 = mayor esfuerzo'):(en?'Fixed sample, population 2025':'Muestra fija, población 2025')}</small></div>
      </dl>
    </>}

    {(kind==='indicator'||kind==='city')&&<>
      {city&&<div class="an-prose"><h2>{en?`What the index says about ${city.name}`:`Qué dice el índice sobre ${city.name}`}</h2><p>{en?`In ${period}, an 80 m² home at the municipal asking-price benchmark costs €${format(row!.price!*80,lang,0)}. Compared with estimated annual household income of €${format(row!.income,lang,0)}, that is ${format(row!.index,lang)} times income. ${city.name} ranks ${row!.rank} out of the 100 municipalities, from highest to lowest effort.`:`En ${period}, una vivienda de 80 m² al precio ofertado de referencia municipal cuesta ${format(row!.price!*80,lang,0)} €. Frente a una renta anual estimada del hogar de ${format(row!.income,lang,0)} €, equivale a ${format(row!.index,lang)} rentas. ${city.name} ocupa el puesto ${row!.rank} de los 100 municipios, ordenados de mayor a menor esfuerzo.`}</p><p>{en?`The sample median is ${format(stats.median,lang)}. The municipal result is ${format(Math.abs(row!.index-stats.median),lang)} income multiples ${row!.index>=stats.median?'above':'below'} it. This comparison says nothing about an individual household’s savings, credit access or property requirements.`:`La mediana de la muestra es ${format(stats.median,lang)}. El resultado municipal está ${format(Math.abs(row!.index-stats.median),lang)} rentas ${row!.index>=stats.median?'por encima':'por debajo'}. Esa diferencia no informa del ahorro, el acceso al crédito ni las necesidades de vivienda de un hogar concreto.`}</p><p><a href={city.sourcePrice} target="_blank" rel="noopener noreferrer">{en?'Original municipal asking-price history (Idealista)':'Histórico municipal de precios ofertados (Idealista)'} ↗</a></p></div>}
      <Explorer client:visible cities={explorerCities} quarters={qs} lang={lang} endQuarter={quarter} initialCity={city?.code} showRanking={!city}/>
      {city&&<section class="an-panel"><h2>{en?'More recent prices, without an effort estimate':'Precios más recientes, sin estimación de esfuerzo'}</h2><p class="an-small">{en?'This edition has no income estimate after Q1 2026. Complete asking prices for Q2 and partial Q3 prices do not justify extending the IHEC.':'Esta edición no dispone de renta estimada posterior a 2026T1. Los precios completos de T2 y parciales de T3 no permiten prolongar el IHEC.'}</p><div class="an-table-scroll"><table><caption>{en?'Supplementary prices only · excluded from index rankings':'Solo precios complementarios · excluidos del ranking del índice'}</caption><thead><tr><th>{en?'Municipality':'Municipio'}</th><th>2026{en?'Q':'T'}2 · €/m²</th><th>2026{en?'Q':'T'}3 · €/m²</th><th>{en?'Q3 coverage':'Cobertura T3'}</th></tr></thead><tbody>{(city?[city]:data.cities).map(c=>{const q2=c.observations.find(o=>o.quarter==='2026Q2')!,q3=c.observations.find(o=>o.quarter==='2026Q3')!;return <tr><th scope="row">{c.name}</th><td>{format(q2.price,lang)}</td><td>{format(q3.price,lang)}</td><td>{q3.priceMonths===2?(en?'July–August':'Julio–agosto'):(en?'July only':'Solo julio')}</td></tr>})}</tbody></table></div></section>}
    </>}

    {kind==='report'&&<>
      <div class="an-prose"><h2>{en?'The quarter in context':'El trimestre en contexto'}</h2>
        <p>{en?`In ${period}, the median IHEC across the fixed sample of 100 municipalities was ${format(stats.median,lang)}. Half of the municipal observations lie on either side of the median. It is a summary of this sample, not the average effort of Spanish households. The index divides a reference asking price for 80 m² by estimated annual household income.`:`En ${period}, la mediana del IHEC en la muestra fija de 100 municipios fue de ${format(stats.median,lang)}. La mitad de las observaciones municipales queda a cada lado de la mediana. Resume esta muestra: no es el esfuerzo medio de los hogares españoles. El índice divide un precio ofertado de referencia para 80 m² entre la renta anual estimada del hogar.`}</p>
        <p>{en?`${stats.leader.name} recorded the highest ratio (${format(stats.leader.index,lang)}), followed by ${stats.rows[1].name} (${format(stats.rows[1].index,lang)}) and ${stats.rows[2].name} (${format(stats.rows[2].index,lang)}). At the other end, ${stats.lowest.name} recorded ${format(stats.lowest.index,lang)}. The difference between the highest and lowest ratios was ${format(stats.leader.index-stats.lowest.index,lang)} annual income multiples.`:`${stats.leader.name} registró el cociente más alto (${format(stats.leader.index,lang)}), seguido de ${stats.rows[1].name} (${format(stats.rows[1].index,lang)}) y ${stats.rows[2].name} (${format(stats.rows[2].index,lang)}). En el otro extremo, ${stats.lowest.name} registró ${format(stats.lowest.index,lang)}. La distancia entre el mayor y el menor cociente fue de ${format(stats.leader.index-stats.lowest.index,lang)} rentas anuales.`}</p>
        <h2>{en?'What changed from the previous quarter':'Qué cambió respecto al trimestre anterior'}</h2>
        {first?<p>{en?'This is the first observation in the reconstructed series. No quarterly or annual change is calculated because earlier observations are outside the supplied dataset. The quarter provides the starting point for subsequent reports; a missing comparison must not be read as zero growth.':'Es la primera observación de la serie reconstruida. No se calcula variación trimestral ni interanual porque las observaciones anteriores quedan fuera del archivo aportado. Este trimestre proporciona el punto de partida de los informes siguientes; una comparación ausente no equivale a crecimiento cero.'}</p>:<><p>{en?`Compared with ${quarterLabel(previousQuarter(quarter),lang)}, the sample median changed by ${percent(stats.qoq,lang)}. The index increased in ${stats.increases} municipalities and decreased in ${stats.decreases}. These counts describe changes in a modelled price-income ratio, not changes in the number of households able to buy.`:`Frente a ${quarterLabel(previousQuarter(quarter),lang)}, la mediana de la muestra varió un ${percent(stats.qoq,lang)}. El índice subió en ${stats.increases} municipios y bajó en ${stats.decreases}. Los recuentos describen cambios en un cociente modelizado de precio y renta, no cambios en el número de hogares que pueden comprar.`}</p>{stats.fastest&&<p>{en?`The largest quarterly change was in ${stats.fastest.name}: ${percent(stats.fastest.qoq,lang)}, with an index of ${format(stats.fastest.index,lang)}. The same national income factor applies across the sample; differences in municipal changes therefore reflect their different asking-price paths. They do not demonstrate locally observed income growth.`:`La mayor variación trimestral se registró en ${stats.fastest.name}: ${percent(stats.fastest.qoq,lang)}, con un índice de ${format(stats.fastest.index,lang)}. El mismo factor nacional de renta se aplica a toda la muestra; las diferencias de variación municipal reflejan, por tanto, sus distintas trayectorias de precios ofertados. No demuestran crecimientos de renta observados localmente.`}</p>}</>}
        <p>{stats.yoy===null?(en?'A year-on-year comparison is unavailable for this quarter within the supplied series.':'No hay comparación interanual disponible para este trimestre dentro de la serie aportada.'):(en?`Compared with the same quarter a year earlier, the median changed by ${percent(stats.yoy,lang)}. This is the change in the median, not the median of individual municipal changes.`:`Frente al mismo trimestre de un año antes, la mediana varió un ${percent(stats.yoy,lang)}. Es la variación de la mediana, no la mediana de las variaciones municipales.`)}</p>
        <h2>{en?'How to interpret these results':'Cómo interpretar los resultados'}</h2><p>{en?'The reference home has the same floor area in every municipality, but not necessarily the same quality, location or characteristics. Prices are asking prices and the income denominator is estimated. The index excludes financing, taxes and living costs. No causal conclusion about policy, tourism, employment or mortgage rates follows from this ranking alone.':'La vivienda de referencia tiene la misma superficie en cada municipio, pero no necesariamente la misma calidad, ubicación o características. Los precios son de oferta y la renta del denominador es estimada. Se excluyen financiación, impuestos y gastos de vida. Este ranking, por sí solo, no permite atribuir los cambios a políticas, turismo, empleo o tipos hipotecarios.'}</p>
      </div>
      <figure class="an-figure"><picture><source type="image/webp" srcset={`${image.replace('.png','-800.webp')} 800w, ${image.replace('.png','-1200.webp')} 1200w`} sizes="(min-width: 1120px) 1120px, 100vw"/><img src={image} alt={imageAlt} width="1200" height="630" loading="lazy" decoding="async"/></picture><figcaption>{imageAlt} {en?'Source: Hipotecalc calculations, Idealista and INE.':'Fuente: elaboración de Hipotecalc, Idealista e INE.'}</figcaption></figure>
      <section class="an-panel"><h2>{en?'Full quarterly ranking':'Ranking trimestral completo'}</h2><QuarterlyRanking client:visible rows={stats.rows.map(r=>({code:r.code,rank:r.rank,name:r.name,index:r.index,qoq:r.qoq,yoy:r.yoy}))} quarter={quarter} lang={lang}/></section>
    </>}

    {kind==='methodology'&&<Methodology lang={lang}/>}
    {(kind==='hub'||kind==='indicator')&&<section><h2>{en?'Explore a municipality':'Explora un municipio'}</h2><div class="an-grid">{Object.entries(pilotCities).map(([slug,code])=>{const r=stats.rows.find(r=>r.code===code)!;return <a class="an-card" href={`${base(lang)}/${slug}`}><p class="an-kicker">{r.province}</p><h3>{r.name}</h3><span class="an-value">{format(r.index,lang)}×</span><p>{en?'Estimated effort':'Esfuerzo estimado'} · {period} · {en?'Rank':'Puesto'} {r.rank}</p><span class="an-link">{en?'View history and context':'Ver evolución y contexto'} →</span></a>})}</div></section>}
    {(kind==='archive'||kind==='hub'||kind==='indicator')&&<section><h2>{en?'Quarterly report archive':'Archivo de informes trimestrales'}</h2><p class="an-small">{en?'Historical reconstructions with the current documented methodology. Every edition has a permanent URL.':'Reconstrucciones históricas con la metodología documentada. Cada edición tiene una URL permanente.'}</p><div class="an-grid">{(kind==='hub'?archive.slice(0,3):archive).map(q=>{const s=summary(q,reportSource(q));return <a href={reportPath(q,lang)} class="an-card"><p class="an-kicker">{quarterLabel(q,lang)}</p><h3>{en?'Estimated home purchase effort':'Esfuerzo de compra estimado'}</h3><span class="an-value">{format(s.median,lang)}×</span><p>{en?'Median of the 100 municipalities':'Mediana de los 100 municipios'}</p><span class="an-link">{en?'Read the report':'Leer el informe'} →</span></a>})}</div>{kind==='hub'&&<a class="an-button secondary" href={reportsPath(lang)}>{en?'All historical reports':'Todos los informes históricos'} →</a>}</section>}
    {kind==='report'&&<nav class="an-archive" aria-label={en?'Other report editions':'Otras ediciones'}>{nearbyReports.map(link=><a href={link.href}>{link.label}</a>)}<a href={reportsPath(lang)}>{en?'All reports':'Todos los informes'}</a><a href={base(lang)}>{en?'Latest index':'Último índice'} →</a></nav>}
    {(kind==='indicator'||kind==='report'||kind==='city')&&<section class="an-panel" id="citar"><p class="an-kicker">{en?'FOR JOURNALISTS & RESEARCHERS':'PARA PERIODISTAS E INVESTIGADORES'}</p><h2>{en?'Cite this analysis':'Cita este análisis'}</h2><p class="an-citation">{citation}</p><CopyCitation client:visible text={citation} lang={lang}/><div class="an-actions"><a class="an-button secondary" href={downloadPath(lang,kind==='report'?quarter:'all',source.version)} download>{en?'Download derived results (CSV)':'Descargar resultados derivados (CSV)'}</a><a class="an-button secondary" href={image} download>{en?'Download quarterly chart (PNG)':'Descargar gráfico trimestral (PNG)'}</a><a href={methodPath(lang)}>{en?'Sources and reuse conditions':'Fuentes y condiciones de reutilización'} →</a></div><p class="an-small">{en?'CSV includes derived index results and attribution, not the complete underlying source database. Municipal pages download the full series; the chart shows the six highest-effort municipalities.':'El CSV incluye resultados derivados del índice y atribución, no la base original completa. Las fichas municipales descargan la serie completa; el gráfico muestra los seis municipios con mayor esfuerzo.'}</p></section>}
    {kind!=='methodology'&&<aside class="an-notice">{en?'Municipal income is estimated using a common national growth factor. It cannot capture different local income trends.':'La renta municipal se estima con un factor de evolución nacional común. No permite captar crecimientos locales de renta diferentes.'} <a href={methodPath(lang)}>{en?'Read the methodology and limits':'Consulta la metodología y sus límites'} →</a></aside>}
    <div class="an-actions"><a href={en?'/en/mortgage-calculator':'/calculadora-hipotecaria'}>{en?'Calculate your mortgage':'Calcula tu hipoteca'} →</a><a href={en?'/en/itp-calculator':'/calculadora-itp'}>{en?'Calculate your ITP':'Calcula tu ITP'} →</a><a href={en?'/en/financial-disclaimer':'/disclaimer-financiero'}>{en?'Financial disclaimer':'Disclaimer financiero'}</a></div>
  </div>
</Layout>
