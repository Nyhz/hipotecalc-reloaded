---
export interface FAQItem {
  question: string;
  answer: string;
}
export interface Props {
  title: string;
  items: FAQItem[];
}
const { title, items } = Astro.props;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
});
---
<section class="w-full max-w-4xl mx-auto py-12 px-4">
  <h2 class="font-heading text-2xl md:text-3xl font-semibold text-ink mb-8 text-center">{title}</h2>
  <div class="space-y-4">
    {items.map(item => (
      <details class="group pl-card p-6">
        <summary class="flex items-center justify-between cursor-pointer font-heading font-semibold text-ink transition-colors">
          <span>{item.question}</span>
          <span class="ml-4 text-ink-soft group-open:rotate-180 transition-transform duration-200 text-xs">▼</span>
        </summary>
        <div class="pt-4 text-ink-soft leading-relaxed">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>
<script type="application/ld+json" set:html={jsonLd} />
