---
import { t } from '../utils/i18n';
import { getTools } from '../constants/tools';

export interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const tools = getTools(lang);
const homeHref = lang === 'en' ? '/en' : '/';

const legalLinks = lang === 'en'
  ? [
      { label: 'About us', href: '/en/about' },
      { label: 'Our advisor', href: '/en/authors/jose-perales' },
      { label: 'Methodology', href: '/en/methodology' },
      { label: 'Legal notice', href: '/en/legal-notice' },
      { label: 'Privacy policy', href: '/en/privacy-policy' },
      { label: 'Cookie policy', href: '/en/cookie-policy' },
      { label: 'Financial disclaimer', href: '/en/financial-disclaimer' },
    ]
  : [
      { label: 'Sobre nosotros', href: '/sobre-nosotros' },
      { label: 'Nuestro asesor', href: '/autores/jose-perales' },
      { label: 'Metodología', href: '/metodologia' },
      { label: 'Aviso legal', href: '/aviso-legal' },
      { label: 'Política de privacidad', href: '/politica-de-privacidad' },
      { label: 'Política de cookies', href: '/politica-de-cookies' },
      { label: 'Disclaimer financiero', href: '/disclaimer-financiero' },
    ];

const officialSources = [
  { label: lang === 'en' ? 'Bank of Spain' : 'Banco de España', href: 'https://www.bde.es/' },
  { label: 'EMMI · Euribor', href: 'https://www.emmi-benchmarks.eu/' },
  { label: lang === 'en' ? 'ECB Data Portal' : 'BCE · Data Portal', href: 'https://data.ecb.europa.eu/' },
];
---
<footer class="w-full mt-16 bg-ink text-paper">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-md">
        <a href={homeHref} class="font-heading text-2xl font-bold tracking-tight text-paper">
          hipotecalc<span class="text-lime">.</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-paper/60">
          {lang === 'en'
            ? 'Professional mortgage and rental analysis tools tailored for Spain.'
            : 'Herramientas profesionales para analizar hipotecas, alquileres e impuestos en España.'}
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-10">
        <div>
          <h3 class="font-data text-xs font-semibold uppercase tracking-widest text-paper/50">
            {lang === 'en' ? 'Tools' : 'Herramientas'}
          </h3>
          <ul class="mt-3 space-y-2">
            {tools.filter((tool) => tool.active).map((tool) => (
              <li>
                <a href={tool.href} class="text-sm font-medium text-paper/80 hover:text-lime transition-colors">
                  {tool.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-data text-xs font-semibold uppercase tracking-widest text-paper/50">
            Legal
          </h3>
          <ul class="mt-3 space-y-2">
            {legalLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm font-medium text-paper/80 hover:text-lime transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-data text-xs font-semibold uppercase tracking-widest text-paper/50">
            {lang === 'en' ? 'Official sources' : 'Fuentes oficiales'}
          </h3>
          <ul class="mt-3 space-y-2">
            {officialSources.map((source) => (
              <li>
                <a
                  href={source.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-medium text-paper/80 hover:text-lime transition-colors"
                >
                  {source.label} ↗
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-6 font-data text-xs text-paper/40">
            © {new Date().getFullYear()} Hipotecalc. {t('footer.copyright', lang)}
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
